<%= form_with(model: item, url: admin_school_path(item), method: :put, data: { controller: "campuses grade-subjects semesters user-campuses" }) do |form| %>
  <div class="wt-surface mb-4 flex flex-wrap items-end gap-3 p-4">
    <div class="min-w-48 flex-1">
      <%= form.label :name, "学校名称", class: "mb-1 block text-xs font-medium text-base-content/60" %>
      <%= form.text_field :name, class: "input w-full", placeholder: "请输入学校名称", required: true %>
    </div>
    <%= form.submit "保存修改", class: "btn btn-primary" %>
  </div>

  <details class="collapse collapse-arrow mb-3 rounded-box border border-base-300 bg-base-100" open>
    <summary class="collapse-title flex items-center gap-2 font-semibold">
      校区管理 <span class="badge badge-ghost badge-sm"><%= item.campuses.size %></span>
    </summary>
    <div class="collapse-content">
      <div class="overflow-x-auto">
        <table class="table table-sm">
          <thead>
            <tr><th class="w-10"></th><th>校区名称</th><th class="text-right">操作</th></tr>
          </thead>
          <tbody data-campuses-target="tbody">
            <%= form.fields_for :campuses, item.campuses do |campus_form| %>
              <tr id="campus_<%= campus_form.object.id %>">
                <td><%= campus_form.hidden_field :id %><%= campus_form.hidden_field :_destroy %></td>
                <td><%= campus_form.text_field :name, class: "input input-sm w-full", placeholder: "校区名称", required: true %></td>
                <td class="text-right">
                  <button type="button" data-action="campuses#deleteRow" class="btn btn-xs btn-square btn-ghost text-error" title="删除" aria-label="删除校区">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
                  </button>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      <button type="button" data-action="campuses#addRow" class="btn btn-sm btn-outline btn-primary mt-3">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" /></svg>
        添加校区
      </button>
      <template data-campuses-target="template">
        <%= form.fields_for :campuses, Campuse.new, child_index: "new_campus" do |campus_form| %>
          <tr id="campus_new">
            <td><%= campus_form.hidden_field :id %><%= campus_form.hidden_field :_destroy %></td>
            <td><%= campus_form.text_field :name, class: "input input-sm w-full", placeholder: "校区名称", required: true %></td>
            <td class="text-right">
              <button type="button" data-action="campuses#deleteRow" class="btn btn-xs btn-square btn-ghost text-error" title="删除" aria-label="删除校区">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
              </button>
            </td>
          </tr>
        <% end %>
      </template>
    </div>
  </details>

  <details class="collapse collapse-arrow mb-3 rounded-box border border-base-300 bg-base-100">
    <summary class="collapse-title flex items-center gap-2 font-semibold">
      年级科目管理 <span class="badge badge-ghost badge-sm"><%= item.grade_subjects.size %></span>
    </summary>
    <div class="collapse-content">
      <div class="overflow-x-auto">
        <table class="table table-sm">
          <thead>
            <tr><th class="w-10"></th><th>年级</th><th>科目</th><th class="text-right">操作</th></tr>
          </thead>
          <tbody data-grade-subjects-target="tbody">
            <%= form.fields_for :grade_subjects, item.grade_subjects do |grade_subject_form| %>
              <tr id="grade-subject-<%= grade_subject_form.object.id %>">
                <td><%= grade_subject_form.hidden_field :id %><%= grade_subject_form.hidden_field :_destroy %></td>
                <td><%= grade_subject_form.collection_select :grade_id, Grade.all, :id, :name, { prompt: "选择年级" }, { class: "select select-sm", required: true } %></td>
                <td><%= grade_subject_form.collection_select :subject_id, Subject.all, :id, :name, { prompt: "选择科目" }, { class: "select select-sm", required: true } %></td>
                <td class="text-right">
                  <button type="button" data-action="grade-subjects#deleteRow" class="btn btn-xs btn-square btn-ghost text-error" title="删除" aria-label="删除年级科目">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
                  </button>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      <button type="button" data-action="grade-subjects#addRow" class="btn btn-sm btn-outline btn-primary mt-3">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" /></svg>
        添加年级科目
      </button>
      <template data-grade-subjects-target="template">
        <%= form.fields_for :grade_subjects, GradeSubject.new, child_index: "new_grade_subject" do |grade_subject_form| %>
          <tr id="grade-subject-new">
            <td><%= grade_subject_form.hidden_field :id %><%= grade_subject_form.hidden_field :_destroy %></td>
            <td><%= grade_subject_form.collection_select :grade_id, Grade.all, :id, :name, { prompt: "选择年级" }, { class: "select select-sm", required: true } %></td>
            <td><%= grade_subject_form.collection_select :subject_id, Subject.all, :id, :name, { prompt: "选择科目" }, { class: "select select-sm", required: true } %></td>
            <td class="text-right">
              <button type="button" data-action="grade-subjects#deleteRow" class="btn btn-xs btn-square btn-ghost text-error" title="删除" aria-label="删除年级科目">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
              </button>
            </td>
          </tr>
        <% end %>
      </template>
    </div>
  </details>

  <details class="collapse collapse-arrow mb-3 rounded-box border border-base-300 bg-base-100">
    <summary class="collapse-title flex items-center gap-2 font-semibold">
      学期管理 <span class="badge badge-ghost badge-sm"><%= item.semesters.size %></span>
    </summary>
    <div class="collapse-content">
      <div class="overflow-x-auto">
        <table class="table table-sm">
          <thead>
            <tr><th class="w-10"></th><th>学期名称</th><th>开始日期</th><th>结束日期</th><th>序号</th><th class="text-right">操作</th></tr>
          </thead>
          <tbody data-semesters-target="tbody">
            <%= form.fields_for :semesters, item.semesters do |semester_form| %>
              <tr id="semester-<%= semester_form.object.id %>">
                <td><%= semester_form.hidden_field :id %><%= semester_form.hidden_field :_destroy, value: "false" %></td>
                <td><%= semester_form.text_field :name, class: "input input-sm", placeholder: "学期名称", required: true %></td>
                <td><%= semester_form.date_field :start_date, class: "input input-sm", required: true %></td>
                <td><%= semester_form.date_field :end_date, class: "input input-sm", required: true %></td>
                <td><%= semester_form.number_field :seq, class: "input input-sm w-20", required: true %></td>
                <td class="text-right">
                  <button type="button" data-action="semesters#deleteRow" class="btn btn-xs btn-square btn-ghost text-error" title="删除" aria-label="删除学期">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
                  </button>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      <button type="button" data-action="semesters#addRow" class="btn btn-sm btn-outline btn-primary mt-3">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" /></svg>
        添加学期
      </button>
      <template data-semesters-target="template">
        <%= form.fields_for :semesters, Semester.new, child_index: "new_semester" do |semester_form| %>
          <tr id="semester-new">
            <td><%= semester_form.hidden_field :id %><%= semester_form.hidden_field :_destroy %></td>
            <td><%= semester_form.text_field :name, class: "input input-sm", placeholder: "学期名称", required: true %></td>
            <td><%= semester_form.date_field :start_date, class: "input input-sm", required: true %></td>
            <td><%= semester_form.date_field :end_date, class: "input input-sm", required: true %></td>
            <td><%= semester_form.number_field :seq, class: "input input-sm w-20", required: true %></td>
            <td class="text-right">
              <button type="button" data-action="semesters#deleteRow" class="btn btn-xs btn-square btn-ghost text-error" title="删除" aria-label="删除学期">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
              </button>
            </td>
          </tr>
        <% end %>
      </template>
    </div>
  </details>

  <details class="collapse collapse-arrow mb-3 rounded-box border border-base-300 bg-base-100">
    <summary class="collapse-title flex items-center gap-2 font-semibold">
      用户校区授权 <span class="badge badge-ghost badge-sm"><%= item.user_campuses.size %></span>
    </summary>
    <div class="collapse-content">
      <div class="overflow-x-auto">
        <table class="table table-sm">
          <thead>
            <tr><th class="w-10"></th><th>用户</th><th>校区</th><th>授权年级</th><th>角色</th><th class="text-right">操作</th></tr>
          </thead>
          <tbody data-user-campuses-target="container">
            <%= form.fields_for :user_campuses, item.user_campuses do |user_campus_form| %>
              <tr id="user-campus-<%= user_campus_form.object.id %>" class="nested-fields" data-new-record="false">
                <td><%= user_campus_form.hidden_field :id %><%= user_campus_form.hidden_field :school_id, value: item.id %><%= user_campus_form.hidden_field :_destroy, value: "false" %></td>
                <td><%= user_campus_form.collection_select :user_id, User.all, :id, :name, { prompt: "选择用户" }, { class: "select select-sm", required: true } %></td>
                <td><%= user_campus_form.collection_select :campuse_id, item.campuses, :id, :name, { prompt: "选择校区" }, { class: "select select-sm", required: true } %></td>
                <td><%= user_campus_form.collection_select :grade_ids, Grade.all, :id, :name, { prompt: "选择年级" }, { class: "select select-sm", multiple: true } %></td>
                <td><%= user_campus_form.collection_select :role, UserCampuse::ROLES.to_a, :first, :last, { prompt: "选择角色" }, { class: "select select-sm" } %></td>
                <td class="text-right">
                  <button type="button" data-action="user-campuses#remove" class="btn btn-xs btn-square btn-ghost text-error" title="删除" aria-label="删除授权">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
                  </button>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      <button type="button" data-action="user-campuses#add" class="btn btn-sm btn-outline btn-primary mt-3">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" /></svg>
        添加用户校区授权
      </button>
      <template data-user-campuses-target="template">
        <%= form.fields_for :user_campuses, UserCampuse.new, child_index: "NEW_RECORD" do |user_campus_form| %>
          <tr id="user-campus-new" class="nested-fields" data-new-record="true">
            <td><%= user_campus_form.hidden_field :id %><%= user_campus_form.hidden_field :school_id, value: item.id %><%= user_campus_form.hidden_field :_destroy, value: "false" %></td>
            <td><%= user_campus_form.collection_select :user_id, User.all, :id, :name, { prompt: "选择用户" }, { class: "select select-sm", required: true } %></td>
            <td><%= user_campus_form.collection_select :campuse_id, item.campuses, :id, :name, { prompt: "选择校区" }, { class: "select select-sm", required: true } %></td>
            <td><%= user_campus_form.collection_select :grade_ids, Grade.all, :id, :name, { prompt: "选择年级" }, { class: "select select-sm", multiple: true } %></td>
            <td><%= user_campus_form.collection_select :role, UserCampuse::ROLES.to_a, :first, :last, { prompt: "选择角色" }, { class: "select select-sm" } %></td>
            <td class="text-right">
              <button type="button" data-action="user-campuses#remove" class="btn btn-xs btn-square btn-ghost text-error" title="删除" aria-label="删除授权">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
              </button>
            </td>
          </tr>
        <% end %>
      </template>
    </div>
  </details>

  <div class="mt-4 flex justify-end">
    <%= form.submit "保存修改", class: "btn btn-primary" %>
  </div>
<% end %>
