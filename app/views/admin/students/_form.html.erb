<%= form_with(
  model: item,
  url: item.new_record? ? admin_students_path : admin_student_path(id: item.id),
  namespace: "student_#{item.id || 'new'}",
  local: true, data: { controller: "guardians" }) do |f| %>
  <div class="wt-surface space-y-3 p-4">
    <h3 class="text-sm font-semibold"><%= item.new_record? ? "添加学员" : "学员档案 · #{item.name}" %></h3>

    <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
      <div>
        <%= f.label :name, "学员名", class: "mb-1 block text-xs font-medium text-base-content/60" %>
        <%= f.text_field :name, class: "input input-sm w-full", placeholder: "请输入学员姓名", required: true, maxlength: 50, autocomplete: "off" %>
      </div>

      <div>
        <%= f.label :phone, "电话", class: "mb-1 block text-xs font-medium text-base-content/60" %>
        <%= f.text_field :phone, class: "input input-sm w-full", placeholder: "选填", autocomplete: "off" %>
      </div>

      <div>
        <%= f.label :grade_id, "年级", class: "mb-1 block text-xs font-medium text-base-content/60" %>
        <%= f.select :grade_id, (@grades || Current.user.grades_by_campuse(Thread.current[:campuse].id).order(:level)).map { |grade| [ grade.name, grade.id ] }, { prompt: "请选择年级" }, class: "select select-sm w-full", required: true %>
      </div>

      <div>
        <%= f.label :day_school_id, "日校", class: "mb-1 block text-xs font-medium text-base-content/60" %>
        <%= f.select :day_school_id, (@day_schools || DaySchool.where(campuse_id: Thread.current[:campuse].id).order(:name)).map { |day_school| [ day_school.name, day_school.id ] }, { prompt: "请选择日校" }, class: "select select-sm w-full" %>
      </div>

      <div>
        <%= f.label :layer, "学员分层", class: "mb-1 block text-xs font-medium text-base-content/60" %>
        <%= f.select :layer, (1..7).map { |layer| [ layer, layer ] }, { prompt: "请选择分层" }, class: "select select-sm w-full" %>
      </div>

      <div>
        <%= f.label :in_date, "入学日期", class: "mb-1 block text-xs font-medium text-base-content/60" %>
        <%= f.date_field :in_date, class: "input input-sm w-full", value: item.in_date&.strftime("%Y-%m-%d") || Date.today.strftime("%Y-%m-%d") %>
      </div>

      <div>
        <%= f.label :birthday, "生日", class: "mb-1 block text-xs font-medium text-base-content/60" %>
        <%= f.date_field :birthday, class: "input input-sm w-full", value: item.birthday&.strftime("%Y-%m-%d") %>
      </div>

      <div>
        <span class="mb-1 block text-xs font-medium text-base-content/60">性别</span>
        <div class="flex items-center gap-5 pt-1.5">
          <label class="flex cursor-pointer items-center gap-2">
            <%= f.radio_button :gender, "male", class: "radio radio-sm radio-primary" %>
            <span class="text-sm">男</span>
          </label>
          <label class="flex cursor-pointer items-center gap-2">
            <%= f.radio_button :gender, "female", class: "radio radio-sm radio-secondary" %>
            <span class="text-sm">女</span>
          </label>
        </div>
      </div>
    </div>
  </div>

  <div class="wt-surface mt-3 p-4">
    <div class="mb-2 flex items-center justify-between">
      <h3 class="text-sm font-semibold">监护人</h3>
      <button type="button" data-action="guardians#add" class="btn btn-xs btn-outline btn-primary">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" /></svg>
        添加
      </button>
    </div>

    <div class="overflow-x-auto">
      <table class="table table-sm">
        <thead>
          <tr><th class="w-10"></th><th>姓名</th><th>电话</th><th>关系</th><th class="text-right">操作</th></tr>
        </thead>
        <tbody data-guardians-target="container">
          <%= f.fields_for :guardians, item.guardians do |guardian_form| %>
            <tr id="guardian-<%= guardian_form.object.id %>" class="nested-fields" data-new-record="false">
              <td><%= guardian_form.hidden_field :id %><%= guardian_form.hidden_field :_destroy, value: "false" %></td>
              <td><%= guardian_form.text_field :name, class: "input input-sm w-full", placeholder: "监护人姓名", required: true %></td>
              <td><%= guardian_form.text_field :phone, class: "input input-sm w-full", placeholder: "联系电话", required: true %></td>
              <td><%= guardian_form.text_field :relationship, class: "input input-sm w-full", placeholder: "与学员关系" %></td>
              <td class="text-right">
                <button type="button" data-action="guardians#remove" class="btn btn-xs btn-square btn-ghost text-error" title="删除" aria-label="删除监护人">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
                </button>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <template data-guardians-target="template">
      <%= f.fields_for :guardians, Guardian.new, child_index: "NEW_RECORD" do |guardian_form| %>
        <tr class="nested-fields" data-new-record="true">
          <td><%= guardian_form.hidden_field :id %><%= guardian_form.hidden_field :_destroy, value: "false" %></td>
          <td><%= guardian_form.text_field :name, class: "input input-sm w-full", placeholder: "监护人姓名", required: true %></td>
          <td><%= guardian_form.text_field :phone, class: "input input-sm w-full", placeholder: "联系电话", required: true %></td>
          <td><%= guardian_form.text_field :relationship, class: "input input-sm w-full", placeholder: "与学员关系" %></td>
          <td class="text-right">
            <button type="button" data-action="guardians#remove" class="btn btn-xs btn-square btn-ghost text-error" title="删除" aria-label="删除监护人">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
            </button>
          </td>
        </tr>
      <% end %>
    </template>
  </div>

  <div class="mt-3 flex justify-end">
    <%= f.submit "保存", class: "btn btn-sm btn-primary" %>
  </div>
<% end %>
