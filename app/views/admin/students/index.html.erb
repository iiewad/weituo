<% content_for :page_title, "学员管理" %>
<% content_for :page_subtitle, "共 #{@students.total_count} 名学员 · #{Thread.current[:campuse]&.name}" %>
<% content_for :page_actions do %>
  <%= render "admin/shared/drawer", item: Student.new, drawer_id: "drawer-student-new", button_name: "添加学员", drawer_width: "240", drawer_content: "admin/students/form" %>
  <%= render "admin/shared/drawer", item: Student.new, drawer_id: "drawer-student-import", button_name: "批量导入", drawer_width: "200", drawer_content: "admin/students/import_form" %>
<% end %>

<%
  filters = [
    [ "全部", nil, @filter_counts[:all], "bg-primary/20", "bg-primary" ],
    [ "在班学员", "in_class", @filter_counts[:in_class], "bg-success/20", "bg-success" ],
    [ "有退课", "out_class", @filter_counts[:out_class], "bg-warning/20", "bg-warning" ],
    [ "未入班", "not_in_class", @filter_counts[:not_in_class], "bg-base-300", "bg-base-content/40" ]
  ]
%>

<div class="mb-5 grid gap-3 sm:grid-cols-2 xl:grid-cols-4">
  <% filters.each do |label, filter, count, track, bar| %>
    <% active = params[:filter].to_s == filter.to_s %>
    <%= link_to admin_students_path(filter: filter, q: params[:q]&.to_unsafe_h, per_page: @per_page),
          class: "wt-surface block p-4 transition hover:border-primary/40 #{ "ring-2 ring-primary/40" if active }" do %>
      <p class="text-xs text-base-content/50"><%= label %></p>
      <p class="mt-1 text-2xl font-semibold"><%= count %><span class="ml-1 text-sm font-normal text-base-content/50">人</span></p>
      <p class="mt-2 h-1 w-full rounded-full <%= track %>"><span class="block h-1 w-full rounded-full <%= bar %>"></span></p>
    <% end %>
  <% end %>
</div>

<div class="mb-4">
  <%= render "admin/students/filter_form" %>
</div>

<%= form_with url: promote_admin_students_path, method: :post, id: "bulk-promote-form", class: "hidden" do |form| %>
<% end %>

<div data-controller="bulk-select" data-action="change->bulk-select#update">
  <div class="mb-3 flex flex-wrap items-center justify-between gap-2">
    <p class="text-xs text-base-content/50">勾选学员后可批量升年级；只更新学员年级，不会调整已入班的班级记录。</p>
    <div class="flex items-center gap-2">
      <span class="text-xs text-base-content/50">
        已选 <span class="font-semibold text-base-content" data-bulk-select-target="count">0</span> 人
      </span>
      <%= button_tag "批量升年级",
            type: "submit",
            form: "bulk-promote-form",
            data: { bulk_select_target: "submit", turbo_confirm: "确定将选中的学员升入下一年级吗？只更新学员年级，不会调整已入班的班级记录。" },
            class: "btn btn-sm btn-primary",
            disabled: true %>
    </div>
  </div>

  <div class="wt-surface overflow-x-auto">
  <table class="table table-sm">
    <thead class="bg-base-200/60 text-xs uppercase tracking-wide text-base-content/60">
      <tr>
        <th class="w-8">
          <%= check_box_tag "bulk_all", "1", false,
                id: "bulk-select-all",
                class: "checkbox checkbox-xs",
                aria: { label: "全选当前页学员" },
                data: { bulk_select_target: "all", action: "change->bulk-select#toggleAll" } %>
        </th>
        <th class="w-12">#</th>
        <th>学员</th>
        <th>性别</th>
        <th>年级</th>
        <th>日校</th>
        <th>层级</th>
        <th>生日</th>
        <th>电话</th>
        <th>监护人</th>
        <th>备注</th>
        <th class="text-right">操作</th>
      </tr>
    </thead>
    <tbody>
      <% @students.each.with_index(1) do |student, index| %>
        <tr id="student-row-<%= student.id %>" class="hover:bg-base-200/40">
          <td>
            <%= check_box_tag "student_ids[]", student.id, false,
                  form: "bulk-promote-form",
                  id: "student-select-#{student.id}",
                  class: "checkbox checkbox-xs",
                  aria: { label: "选择 #{student.name}" },
                  data: { bulk_select_target: "item" } %>
          </td>
          <td class="text-base-content/40"><%= index %></td>
          <td>
            <div class="flex items-center gap-2.5">
              <span class="flex h-8 w-8 items-center justify-center rounded-full bg-primary/10 text-xs font-semibold text-primary"><%= student.name.to_s.first %></span>
              <span class="font-medium"><%= student.name %></span>
              <% if student.name_seq.to_i > 1 %>
                <span class="badge badge-ghost badge-xs" title="重名序号">序号 <%= student.name_seq %></span>
              <% end %>
            </div>
          </td>
          <td>
            <% gender = { "male" => "男", "female" => "女" }[student.gender] || student.gender %>
            <% if gender.present? %>
              <span class="badge badge-ghost badge-sm"><%= gender %></span>
            <% else %>
              <span class="text-base-content/40">—</span>
            <% end %>
          </td>
          <td><span class="badge badge-outline badge-primary badge-sm"><%= student.grade&.name || "—" %></span></td>
          <td class="text-base-content/70"><%= student.day_school&.name || "—" %></td>
          <td><span class="badge badge-ghost badge-sm"><%= student.layer.presence || "—" %></span></td>
          <td class="whitespace-nowrap text-base-content/70"><%= student.birthday&.strftime("%Y-%m-%d") || "—" %></td>
          <td class="whitespace-nowrap text-base-content/70"><%= student.phone.presence || "—" %></td>
          <td class="text-base-content/70"><%= student.guardians.map { |g| [ g.relationship, g.phone ].compact.join(" ") }.join("、").presence || "—" %></td>
          <td class="max-w-[12rem] text-base-content/70">
            <% if student.remark.present? %>
              <div class="truncate" title="<%= student.remark %>"><%= student.remark %></div>
            <% else %>
              <span class="text-base-content/40">—</span>
            <% end %>
          </td>
          <td class="text-right whitespace-nowrap">
            <div class="flex justify-end gap-1">
              <%= render "admin/shared/drawer", item: student,
                    drawer_id: "drawer-student-detail-#{student.id}",
                    button_name: "详情",
                    button_class: "btn btn-xs btn-ghost",
                    drawer_width: "260",
                    drawer_content: "admin/students/detail",
                    drawer_locals: {
                      history: @history_by_student[student.id] || [],
                      attendance_stats: @attendance_stats
                    } %>
              <%= render "admin/shared/drawer", item: student, drawer_id: "drawer-student-#{student.id}", button_name: "编辑", drawer_width: "240", drawer_content: "admin/students/form" %>
            </div>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
    <% if @students.empty? %>
      <div class="p-12 text-center text-sm text-base-content/50">暂无符合条件的学员</div>
    <% end %>
  </div>
</div>

<%
  page_params = {
    filter: params[:filter].presence,
    q: params[:q]&.to_unsafe_h,
    per_page: @per_page
  }.compact
  current_page = @students.current_page
  total_pages = @students.total_pages
  start_page = [ current_page - 2, 1 ].max
  end_page = [ start_page + 4, total_pages ].min
  start_page = [ end_page - 4, 1 ].max
%>

<div class="mt-4 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
  <div class="flex flex-wrap items-center gap-3 text-xs text-base-content/60">
    <span>共 <span class="font-semibold text-base-content"><%= @students.total_count %></span> 名学员</span>

    <%= form_with url: admin_students_path, method: :get, class: "flex items-center gap-1.5" do %>
      <%= hidden_field_tag :filter, params[:filter] if params[:filter].present? %>
      <% (params[:q] || {}).each do |key, value| %>
        <%= hidden_field_tag "q[#{key}]", value %>
      <% end %>
      <label for="students-per-page" class="text-xs">每页</label>
      <%= select_tag :per_page, options_for_select(@per_page_options, @per_page),
            id: "students-per-page",
            class: "select select-xs w-20",
            onchange: "this.form.requestSubmit()" %>
      <span>条</span>
    <% end %>
  </div>

  <% if total_pages > 1 %>
    <nav class="flex flex-wrap items-center justify-center gap-1" aria-label="学员分页">
      <% if current_page > 1 %>
        <%= link_to "‹", admin_students_path(page_params.merge(page: current_page - 1)),
              class: "btn btn-xs btn-square btn-ghost", aria: { label: "上一页" } %>
      <% else %>
        <span class="btn btn-xs btn-square btn-ghost cursor-not-allowed opacity-40" aria-disabled="true">‹</span>
      <% end %>

      <% if start_page > 1 %>
        <%= link_to 1, admin_students_path(page_params.merge(page: 1)), class: "btn btn-xs btn-ghost" %>
        <% if start_page > 2 %>
          <span class="px-1 text-xs text-base-content/40">…</span>
        <% end %>
      <% end %>

      <% (start_page..end_page).each do |page| %>
        <% if page == current_page %>
          <span class="btn btn-xs btn-primary" aria-current="page"><%= page %></span>
        <% else %>
          <%= link_to page, admin_students_path(page_params.merge(page: page)), class: "btn btn-xs btn-ghost" %>
        <% end %>
      <% end %>

      <% if end_page < total_pages %>
        <% if end_page < total_pages - 1 %>
          <span class="px-1 text-xs text-base-content/40">…</span>
        <% end %>
        <%= link_to total_pages, admin_students_path(page_params.merge(page: total_pages)), class: "btn btn-xs btn-ghost" %>
      <% end %>

      <% if current_page < total_pages %>
        <%= link_to "›", admin_students_path(page_params.merge(page: current_page + 1)),
              class: "btn btn-xs btn-square btn-ghost", aria: { label: "下一页" } %>
      <% else %>
        <span class="btn btn-xs btn-square btn-ghost cursor-not-allowed opacity-40" aria-disabled="true">›</span>
      <% end %>
    </nav>
  <% end %>
</div>
