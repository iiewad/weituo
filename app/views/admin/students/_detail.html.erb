<%
  gender = { "male" => "男", "female" => "女" }[item.gender] || item.gender
  status_meta = {
    "in" => [ "在班", "badge-soft badge-success" ],
    "out" => [ "退课", "badge-soft badge-warning" ],
    "transfer" => [ "转出", "badge-soft badge-neutral" ]
  }
  grouped_history = history.group_by { |ks| ks.semester_klass.semester }
%>

<div class="space-y-4">
  <div class="wt-surface p-4">
    <div class="flex items-center gap-3">
      <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-primary/10 text-lg font-semibold text-primary"><%= item.name.to_s.first %></span>
      <div class="min-w-0">
        <p class="truncate text-base font-semibold"><%= item.name %></p>
        <div class="mt-1 flex flex-wrap items-center gap-1">
          <span class="badge badge-outline badge-primary badge-sm"><%= item.grade&.name || "未设置年级" %></span>
          <% if gender.present? %><span class="badge badge-ghost badge-sm"><%= gender %></span><% end %>
          <span class="badge badge-ghost badge-sm">入学 <%= item.in_date&.strftime("%Y-%m-%d") || "—" %></span>
        </div>
      </div>
    </div>

    <dl class="mt-4 grid grid-cols-2 gap-x-4 gap-y-3 text-xs">
      <div>
        <dt class="text-base-content/50">生日</dt>
        <dd class="mt-0.5 font-medium"><%= item.birthday&.strftime("%Y-%m-%d") || "—" %></dd>
      </div>
      <div>
        <dt class="text-base-content/50">电话</dt>
        <dd class="mt-0.5 font-medium"><%= item.phone.presence || "—" %></dd>
      </div>
      <div>
        <dt class="text-base-content/50">日校</dt>
        <dd class="mt-0.5 font-medium"><%= item.day_school&.name || "—" %></dd>
      </div>
      <div>
        <dt class="text-base-content/50">学员分层</dt>
        <dd class="mt-0.5 font-medium"><%= item.layer.presence || "—" %></dd>
      </div>
      <div class="col-span-2">
        <dt class="text-base-content/50">备注</dt>
        <dd class="mt-0.5 whitespace-pre-line font-medium"><%= item.remark.presence || "—" %></dd>
      </div>
    </dl>
  </div>

  <div class="wt-surface p-4">
    <div class="flex items-center justify-between gap-2">
      <h3 class="text-sm font-semibold">监护人</h3>
      <span class="text-xs text-base-content/50">共 <%= item.guardians.size %> 人</span>
    </div>
    <% if item.guardians.any? %>
      <ul class="mt-2 space-y-1.5">
        <% item.guardians.each do |guardian| %>
          <li class="flex items-center justify-between gap-2 rounded-box bg-base-200/60 px-3 py-2 text-xs">
            <span>
              <span class="font-medium"><%= guardian.name %></span>
              <span class="ml-1 text-base-content/50"><%= guardian.relationship %></span>
            </span>
            <span class="text-base-content/60"><%= guardian.phone %></span>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="mt-2 text-xs text-base-content/40">未登记监护人</p>
    <% end %>
  </div>

  <div class="wt-surface p-4">
    <div class="flex items-center justify-between gap-2">
      <h3 class="text-sm font-semibold">历史班级</h3>
      <span class="text-xs text-base-content/50"><%= history.size %> 条记录</span>
    </div>

    <% if history.empty? %>
      <p class="mt-3 text-xs text-base-content/40">暂无班级记录</p>
    <% else %>
      <div class="mt-3 space-y-4">
        <% grouped_history.each do |semester, records| %>
          <% current_semester = semester == Thread.current[:semester] %>
          <div class="rounded-box p-2.5 <%= "border border-primary/30 bg-primary/5" if current_semester %>">
            <div class="flex flex-wrap items-center gap-1.5">
              <span class="badge badge-soft badge-primary badge-sm"><%= semester.name %></span>
              <% if current_semester %>
                <span class="badge badge-primary badge-sm gap-1">
                  <span class="h-1.5 w-1.5 rounded-full bg-primary-content"></span>
                  当前学期
                </span>
              <% end %>
              <span class="text-xs text-base-content/40"><%= records.size %> 个班</span>
            </div>

            <div class="mt-2 space-y-1.5">
              <% records.each do |klass_student| %>
                <% sk = klass_student.semester_klass %>
                <% label, badge_class = status_meta.fetch(klass_student.status, [ klass_student.status, "badge-ghost" ]) %>
                <% counts = attendance_stats[klass_student.id] || {} %>
                <% total = counts.values.sum %>
                <% present = counts["normal"].to_i + counts["filled"].to_i %>
                <% leave = counts["personal_leave"].to_i + counts["sick_leave"].to_i %>
                <% quit_or_transfer = counts["quit"].to_i + counts["transfer"].to_i %>

                <div class="rounded-box border border-base-300 bg-base-100 px-3 py-2">
                  <div class="flex items-center justify-between gap-2">
                    <span class="text-sm font-medium"><%= sk.name %></span>
                    <span class="badge <%= badge_class %> badge-sm"><%= label %></span>
                  </div>
                  <p class="mt-0.5 text-xs text-base-content/50">
                    <%= sk.grade.name %> · <%= sk.subject.name %> · <%= sk.teacher.name %> 老师
                  </p>
                  <% if total.positive? %>
                    <p class="mt-1 text-[11px] text-base-content/40">
                      考勤 <%= total %> 次 · 出勤 <%= present %>
                      <% if leave.positive? %> · 请假 <%= leave %><% end %>
                      <% if counts["absent"].to_i.positive? %> · 缺课 <%= counts["absent"].to_i %><% end %>
                      <% if quit_or_transfer.positive? %> · 退转 <%= quit_or_transfer %><% end %>
                    </p>
                  <% end %>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
