<%= search_form_for @q, url: admin_students_path, class: "flex flex-wrap items-center gap-2 sm:flex-nowrap" do |f| %>
  <%= hidden_field_tag :filter, params[:filter] if params[:filter].present? %>
  <label class="input input-sm flex w-full max-w-xs items-center gap-2 rounded-field">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" class="h-4 w-4 shrink-0 opacity-60"><path fill-rule="evenodd" d="M9.965 11.026a5 5 0 1 1 1.06-1.06l2.755 2.754a.75.75 0 1 1-1.06 1.06l-2.755-2.754ZM10.5 7a3.5 3.5 0 1 1-7 0 3.5 3.5 0 0 1 7 0Z" clip-rule="evenodd" /></svg>
    <%= f.search_field :name_cont, placeholder: "姓名搜索", class: "grow" %>
  </label>
  <%= f.select :grade_id_eq, @grades.map { |g| [ g.name, g.id ] }, { prompt: "全部年级" }, class: "select select-sm w-full max-w-40 rounded-field" %>
  <%= f.submit "查找", class: "btn btn-sm btn-primary" %>
  <% if params[:q].present? || params[:filter].present? %>
    <%= link_to "重置", admin_students_path, class: "btn btn-sm btn-ghost" %>
  <% end %>
<% end %>
