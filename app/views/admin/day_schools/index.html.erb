<% content_for :page_title, "日校管理" %>
<% content_for :page_subtitle, "#{Current.school&.name} · #{Current.campuse&.name} · 维护当前校区的日校名单" %>
<% content_for :page_actions do %>
  <%= render "admin/shared/drawer", item: DaySchool.new, drawer_id: "drawer-day-school-new",
        button_name: "新增日校", drawer_width: "120", drawer_content: "admin/day_schools/form" %>
  <%= render "admin/shared/drawer", item: DaySchool.new, drawer_id: "drawer-day-school-import",
        button_name: "导入", button_class: "btn btn-xs btn-outline btn-primary",
        drawer_width: "160", drawer_content: "admin/day_schools/import_form" %>
<% end %>

<div class="mb-4 flex flex-wrap items-center gap-x-3 gap-y-1 rounded-box border border-primary/20 bg-primary/5 px-4 py-3 text-xs text-base-content/60">
  <span class="badge badge-soft badge-primary badge-sm">说明</span>
  <span>日校用于学员档案的「日校」字段，学员导入时按名称匹配。</span>
  <span class="text-base-content/30">·</span>
  <span>日校按校区维护，切换顶栏校区后分别管理。</span>
  <span class="text-base-content/30">·</span>
  <span>已有学员的日校不能删除。</span>
</div>

<div class="wt-surface overflow-x-auto">
  <table class="table table-sm">
    <thead class="bg-base-200/60 text-xs uppercase tracking-wide text-base-content/60">
      <tr>
        <th class="w-12">#</th>
        <th>日校名称</th>
        <th class="w-28">学员数</th>
        <th class="text-right">操作</th>
      </tr>
    </thead>
    <tbody>
      <% @day_schools.each.with_index(1) do |day_school, index| %>
        <% student_count = @student_counts.fetch(day_school.id, 0) %>
        <tr class="hover:bg-base-200/40">
          <td class="text-base-content/40"><%= index %></td>
          <td class="font-medium"><%= day_school.name %></td>
          <td>
            <span class="badge badge-ghost badge-sm"><%= student_count %> 人</span>
          </td>
          <td>
            <div class="flex items-center justify-end gap-1">
              <%= render "admin/shared/drawer", item: day_school, drawer_id: "drawer-day-school-#{day_school.id}",
                    button_name: "编辑", button_class: "btn btn-xs btn-outline btn-primary",
                    drawer_width: "120", drawer_content: "admin/day_schools/form" %>
              <%= button_to admin_day_school_path(day_school), method: :delete,
                    class: "btn btn-xs btn-square btn-ghost text-error",
                    title: "删除", aria: { label: "删除日校" },
                    data: { turbo_confirm: student_count.positive? ? "该日校下还有 #{student_count} 名学员，不能删除。" : "确定删除日校「#{day_school.name}」吗？" } do %>
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
              <% end %>
            </div>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <% if @day_schools.empty? %>
    <div class="p-10 text-center text-sm text-base-content/50">当前校区还没有日校，点右上角「新增日校」添加。</div>
  <% end %>
</div>
