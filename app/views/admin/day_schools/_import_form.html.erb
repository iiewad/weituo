<%= form_with url: import_admin_day_schools_path, method: :post, local: true, class: "space-y-4" do |form| %>
  <div class="wt-surface p-4">
    <h3 class="text-sm font-semibold">批量导入日校</h3>
    <p class="mt-1 text-xs text-base-content/50">每行一个日校名称，可直接从 Excel 粘贴；同一校区内名称不能重复。</p>

    <div class="mt-3 rounded-box border border-base-300 bg-base-200/50 p-3 font-mono text-[11px] leading-5 text-base-content/60">
      一中<br>
      二中<br>
      实验中学
    </div>

    <ul class="mt-2 space-y-1 text-[11px] leading-snug text-base-content/50">
      <li>· 每行一个名称，多余的列会被忽略。</li>
      <li>· 名称为空或当前校区已存在时跳过，导入结果会提示新增与跳过数量。</li>
    </ul>
  </div>

  <div class="wt-surface p-4">
    <%= form.label :day_schools_text, "日校名单", class: "mb-1 block text-xs font-medium text-base-content/60" %>
    <%= form.text_area :day_schools_text, rows: 8,
          class: "textarea textarea-sm w-full font-mono text-xs leading-5",
          placeholder: "一中\n二中\n实验中学" %>
  </div>

  <%= form.submit "开始导入", class: "btn btn-primary w-full" %>
<% end %>
