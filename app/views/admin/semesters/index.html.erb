<% content_for :page_title, "学期管理" %>
<% content_for :page_subtitle, "#{Current.school&.name} · #{Current.campuse&.name} · 维护当前校区的学期" %>
<% content_for :breadcrumb do %>
  <span>系统设置</span>
  <span>/</span>
  <span>学期管理</span>
<% end %>
<% content_for :page_actions do %>
  <%= render "admin/shared/drawer", item: Semester.new(campuse: Current.campuse, seq: (@semesters.maximum(:seq).to_i + 1)),
        drawer_id: "drawer-semester-new", button_name: "新增学期", drawer_width: "120",
        drawer_content: "admin/semesters/form" %>
<% end %>

<div class="mb-4 flex flex-wrap items-center gap-x-3 gap-y-1 rounded-box border border-primary/20 bg-primary/5 px-4 py-3 text-xs text-base-content/60">
  <span class="badge badge-soft badge-primary badge-sm">说明</span>
  <span>学期按校区维护，切换顶栏校区后分别管理。</span>
  <span class="text-base-content/30">·</span>
  <span>每个校区恰好一个「当前学期」，用于顶栏默认学期与报表口径；删除当前学期后自动把序号最小的学期设为当前。</span>
  <span class="text-base-content/30">·</span>
  <span>删除学期会连同其下班级、课次、考勤与预留记录一并删除，不可恢复。</span>
</div>

<div class="wt-surface overflow-x-auto">
  <table class="table table-sm">
    <thead class="bg-base-200/60 text-xs uppercase tracking-wide text-base-content/60">
      <tr>
        <th class="w-12">#</th>
        <th>学期名称</th>
        <th class="w-20">序号</th>
        <th class="w-28">状态</th>
        <th class="w-24">班级数</th>
        <th class="text-right">操作</th>
      </tr>
    </thead>
    <tbody>
      <% @semesters.each.with_index(1) do |semester, index| %>
        <% klass_count = @klass_counts.fetch(semester.id, 0) %>
        <tr class="hover:bg-base-200/40">
          <td class="text-base-content/40"><%= index %></td>
          <td class="font-medium"><%= semester.name %></td>
          <td class="text-base-content/70"><%= semester.seq %></td>
          <td>
            <% if semester.current? %>
              <span class="badge badge-primary badge-sm">当前学期</span>
            <% else %>
              <%= button_to "设为当前", admin_semester_path(semester, semester: { current: "1" }), method: :put,
                    class: "btn btn-xs btn-ghost text-primary" %>
            <% end %>
          </td>
          <td>
            <span class="badge badge-ghost badge-sm"><%= klass_count %> 个</span>
          </td>
          <td>
            <div class="flex items-center justify-end gap-1">
              <%= render "admin/shared/drawer", item: semester, drawer_id: "drawer-semester-#{semester.id}",
                    button_name: "编辑", button_class: "btn btn-xs btn-outline btn-primary",
                    drawer_width: "120", drawer_content: "admin/semesters/form" %>
              <%= button_to admin_semester_path(semester), method: :delete,
                    class: "btn btn-xs btn-square btn-ghost text-error",
                    title: "删除", aria: { label: "删除学期" },
                    data: { turbo_confirm: "确定删除学期「#{semester.name}」吗？将连同该学期下 #{klass_count} 个班级及全部课次、考勤、预留记录一并删除，不可恢复。" } do %>
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
              <% end %>
            </div>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <% if @semesters.empty? %>
    <div class="p-10 text-center text-sm text-base-content/50">当前校区还没有学期，点右上角「新增学期」添加。</div>
  <% end %>
</div>
