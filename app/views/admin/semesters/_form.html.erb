<%= form_with model: item,
      url: item.new_record? ? admin_semesters_path : admin_semester_path(item),
      method: item.new_record? ? :post : :put,
      namespace: "semester_#{item.id || 'new'}",
      local: true,
      class: "space-y-4" do |form| %>
  <div class="wt-surface p-4">
    <h3 class="text-sm font-semibold"><%= item.new_record? ? "新增学期" : "编辑学期" %></h3>
    <p class="mt-1 text-xs text-base-content/50"><%= Current.campuse&.name %> · 序号决定学期先后顺序，同一校区内不能重复。</p>

    <div class="mt-3 space-y-3">
      <div>
        <%= form.label :name, "学期名称", class: "mb-1 block text-xs font-medium text-base-content/60" %>
        <%= form.text_field :name, class: "input input-sm w-full", placeholder: "例如：2026秋季", required: true, autofocus: item.new_record? %>
      </div>
      <div>
        <%= form.label :seq, "序号", class: "mb-1 block text-xs font-medium text-base-content/60" %>
        <%= form.number_field :seq, class: "input input-sm w-full", required: true, min: 1 %>
      </div>
      <label class="flex cursor-pointer items-center gap-2 text-xs text-base-content/70">
        <%= form.check_box :current, class: "checkbox checkbox-sm checkbox-primary" %>
        设为当前学期
        <span class="text-base-content/40">（每个校区只有一个当前学期；取消勾选保存后会自动把序号最小的学期设为当前）</span>
      </label>
    </div>
  </div>

  <%= form.submit item.new_record? ? "添加学期" : "保存修改", class: "btn btn-primary w-full" %>
<% end %>
