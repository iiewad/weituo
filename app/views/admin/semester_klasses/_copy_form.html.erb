<%= form_with model: SemesterKlass.new,
      url: copy_create_admin_semester_klasses_path,
      namespace: "copy_#{item.id}",
      local: true,
      class: "space-y-4" do |f| %>
<% active_count = @active_counts ? @active_counts.fetch(item.id, 0) : item.current_active_students.count %>
  <%= hidden_field_tag :target_semester_id, @target_semester.id %>
  <%= f.hidden_field :phase, value: item.phase %>
  <% if local_assigns[:return_klass_id].present? %>
    <%= hidden_field_tag :return_klass_id, return_klass_id %>
  <% end %>

  <div class="wt-surface p-4">
    <h3 class="text-sm font-semibold">复制班级</h3>
    <p class="mt-1 text-xs text-base-content/50">从所选班级复制课次与学员名单到目标学期，提交前可调整班级信息。</p>

    <div class="mt-3 rounded-box border border-base-300 bg-base-200/50 p-3">
      <div class="flex flex-wrap items-center gap-1.5">
        <span class="badge badge-ghost badge-sm"><%= item.semester.name %></span>
        <span class="font-medium"><%= item.name %></span>
        <span class="text-xs text-base-content/50"><%= SemesterKlass::GENRE_MAP_REVERSE[item.genre] %></span>
      </div>
      <p class="mt-1.5 text-xs text-base-content/60">
        <%= item.grade.name %> · <%= item.subject.name %> · <%= item.teacher.name %> 老师
      </p>
      <p class="mt-1 text-xs text-base-content/50">
        共 <%= item.times %> 课次 · 在班 <%= active_count %> 人 · 名单 <%= item.students.size %> 人
      </p>
    </div>
  </div>

  <div class="wt-surface p-4">
    <div class="mb-3 flex flex-wrap items-center gap-2 text-xs">
      <span class="text-base-content/50">目标学期</span>
      <span class="badge badge-soft badge-primary badge-sm"><%= @target_semester.name %></span>
      <span class="text-base-content/50">·</span>
      <span class="text-base-content/50"><%= Current.campuse&.name %></span>
    </div>

    <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
      <div>
        <%= f.label :genre, "班型", class: "mb-1 block text-xs font-medium text-base-content/60" %>
        <%= f.select :genre, SemesterKlass::GENRE_MAP.map { |name, code| [ name, code ] }, { selected: item.genre },
              { class: "select select-sm w-full", required: true } %>
      </div>

      <div>
        <%= f.label :seq, "班级序号", class: "mb-1 block text-xs font-medium text-base-content/60" %>
        <%= f.number_field :seq, value: item.seq, min: 1, class: "input input-sm w-full",
              oninput: "this.value = this.value.replace(/4/g, '')" %>
        <p class="mt-1 text-[11px] leading-tight text-base-content/40">序号不可含 4，避免同科目班型冲突。</p>
      </div>

      <div>
        <%= f.label :grade_id, "年级", class: "mb-1 block text-xs font-medium text-base-content/60" %>
        <%= f.select :grade_id,
              Current.user.grades_by_campuse(Current.campuse.id).includes(:subjects).map { |grade| [ grade.name, grade.id ] },
              { selected: item.grade_id }, { class: "select select-sm w-full", required: true } %>
      </div>

      <div>
        <%= f.label :teacher_id, "教师", class: "mb-1 block text-xs font-medium text-base-content/60" %>
        <%= f.select :teacher_id, grouped_options_for_select(@teacher_groups || [], item.teacher_id),
              {}, { class: "select select-sm w-full", required: true } %>
      </div>

      <div class="sm:col-span-2">
        <%= f.label :times, "课次", class: "mb-1 block text-xs font-medium text-base-content/60" %>
        <%= f.number_field :times, value: item.times, min: 1, class: "input input-sm w-full" %>
      </div>
    </div>
  </div>

<%
  source_klass_students = item.klass_students.to_a
  source_ids = source_klass_students.map(&:student_id)
  student_options = source_klass_students.map do |klass_student|
    badge = case klass_student.status
    when "out" then "退课"
    when "transfer" then "转出"
    end
    { student: klass_student.student, checked: klass_student.status == "in", badge: badge }
  end
  (@students_by_grade[item.grade_id] || []).each do |student|
    next if source_ids.include?(student.id)

    student_options << { student: student, checked: false, badge: nil }
  end
  student_options.sort_by! { |option| option[:student].name }
%>

  <div class="wt-surface p-4">
    <div class="flex items-center justify-between gap-2">
      <h3 class="text-sm font-semibold">学员名单</h3>
      <span class="text-xs text-base-content/50">共 <%= student_options.size %> 人可选</span>
    </div>
    <p class="mt-1 text-xs text-base-content/50">默认勾选源班在班学员；可搜索同年级其他学员一并加入，退课/转出默认不选。</p>

    <%= render "admin/shared/student_multiselect",
          options: student_options,
          id_prefix: "copy_#{item.id}",
          hint: "所选学员从第 1 课开始加入；只加入与目标年级一致的学员。",
          empty_message: "没有可复制的学员，请先确认源班或同年级学员。" %>
  </div>

  <%= f.submit "复制到 #{@target_semester.name}", class: "btn btn-primary w-full" %>
<% end %>
