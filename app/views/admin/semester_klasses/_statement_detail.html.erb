<% sk = row.semester_klass %>
<div class="space-y-4">
  <div class="wt-surface p-4">
    <div class="flex items-start justify-between gap-2">
      <div>
        <h3 class="text-sm font-semibold">报表详情 · <%= sk.name %></h3>
        <p class="mt-1 text-xs text-base-content/50">
          <%= sk.semester.name %> · <%= sk.grade.name %> · <%= sk.subject.name %> · <%= sk.teacher.name %> 老师
        </p>
      </div>
      <span class="badge badge-outline <%= sk.genre_badge_class %> badge-sm shrink-0"><%= SemesterKlass::GENRE_MAP_REVERSE[sk.genre] %></span>
    </div>

    <div class="mt-3 grid grid-cols-2 gap-2 text-xs sm:grid-cols-5">
      <div class="rounded-box bg-base-200/60 p-2.5">
        <p class="text-base-content/50">在班</p>
        <p class="mt-0.5 text-lg font-semibold"><%= row.active_count %><span class="ml-0.5 text-[11px] font-normal text-base-content/40">人</span></p>
      </div>
      <% [
        [ "新增", row.new_count, row.new_rate, "" ],
        [ "拓科", row.expand_count, row.expand_rate, "" ],
        [ "预留", row.reserve_count, row.reserve_rate, "" ],
        [ "未预留", row.unreserved_count, row.unreserved_rate, "text-warning" ]
      ].each do |label, count, rate, color| %>
        <div class="rounded-box bg-base-200/60 p-2.5">
          <p class="text-base-content/50"><%= label %></p>
          <p class="mt-0.5 text-lg font-semibold <%= color %>"><%= count %><span class="ml-0.5 text-[11px] font-normal text-base-content/40">人</span></p>
          <p class="text-[10px] text-base-content/40"><%= (rate * 100).round(1) %>%</p>
        </div>
      <% end %>
    </div>
  </div>

  <% if row.unreserved_count.positive? %>
    <div class="wt-surface border border-warning/40 bg-warning/5 p-4">
      <div class="flex items-center justify-between gap-2">
        <h3 class="text-sm font-semibold text-warning">未预留学员</h3>
        <span class="text-xs text-base-content/50"><%= row.unreserved_count %> 人 · 需跟进续报</span>
      </div>
      <p class="mt-1 text-[11px] text-base-content/50">下学期没有同科目班级记录。</p>
      <div class="mt-2 max-h-44 space-y-1 overflow-y-auto pr-1">
        <% row.unreserved_students.each do |entry| %>
          <div class="rounded-box bg-base-100/70 px-2.5 py-1.5">
            <p class="text-xs font-medium"><%= entry.name %></p>
            <p class="mt-0.5 text-[11px] leading-snug text-base-content/50"><%= entry.detail %></p>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <div class="wt-surface p-4">
    <h3 class="text-sm font-semibold">学员构成</h3>
    <div class="mt-3 space-y-3.5">
      <% [
        [ "新增", row.new_count, row.new_rate, row.new_students, "bg-accent" ],
        [ "拓科", row.expand_count, row.expand_rate, row.expand_students, "bg-secondary" ],
        [ "预留", row.reserve_count, row.reserve_rate, row.reserve_students, "bg-primary" ]
      ].each do |label, count, rate, students, color| %>
        <% pct = (rate * 100).round(1) %>
        <div>
          <div class="flex items-center justify-between text-xs">
            <span class="font-medium"><%= label %> <span class="font-normal text-base-content/50"><%= count %> / <%= row.active_count %></span></span>
            <span class="font-semibold"><%= pct %>%</span>
          </div>
          <div class="mt-1 h-1 w-full rounded-full bg-base-200">
            <span class="block h-1 rounded-full <%= color %>" style="width: <%= pct.clamp(0, 100) %>%"></span>
          </div>
          <% if students.any? %>
            <div class="mt-1.5 max-h-44 space-y-1 overflow-y-auto pr-1">
              <% students.each do |entry| %>
                <div class="rounded-box bg-base-200/60 px-2.5 py-1.5">
                  <p class="text-xs font-medium"><%= entry.name %></p>
                  <p class="mt-0.5 text-[11px] leading-snug text-base-content/50"><%= entry.detail %></p>
                </div>
              <% end %>
            </div>
          <% else %>
            <p class="mt-1 text-[11px] text-base-content/40">无</p>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>

  <div class="wt-surface p-4">
    <div class="flex items-center justify-between gap-2">
      <h3 class="text-sm font-semibold">在班名单</h3>
      <span class="text-xs text-base-content/50">
        共 <%= row.active_count %> 人<%= " · 未预留优先" if row.unreserved_count.positive? %>
      </span>
    </div>
    <% if row.active_students.any? %>
      <%
        tag_styles = {
          "新增" => "badge-soft badge-accent",
          "拓科" => "badge-soft badge-secondary",
          "预留" => "badge-soft badge-primary",
          "未预留" => "badge-soft badge-warning"
        }
      %>
      <div class="mt-2 flex max-h-56 flex-wrap gap-1 overflow-y-auto">
        <% row.active_students.each do |entry| %>
          <span class="roster-chip inline-flex items-center gap-1 rounded-full border border-base-300 px-2 py-0.5 text-xs">
            <span><%= entry.name %></span>
            <% entry.tags.each do |tag| %>
              <span class="badge <%= tag_styles.fetch(tag, "badge-ghost") %> badge-xs"><%= tag %></span>
            <% end %>
          </span>
        <% end %>
      </div>
    <% else %>
      <p class="mt-2 text-xs text-base-content/40">该班级暂无在班学员</p>
    <% end %>
  </div>
</div>
