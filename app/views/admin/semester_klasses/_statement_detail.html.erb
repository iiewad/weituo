<% sk = row.semester_klass %>
<div class="space-y-4">
  <div class="wt-surface p-4">
    <div class="flex items-start justify-between gap-2">
      <div>
        <h3 class="text-sm font-semibold">报表详情 · <%= sk.name %></h3>
        <p class="mt-1 text-xs text-base-content/50">
          <%= sk.semester.name %> · <%= sk.grade.name %> · <%= sk.subject.name %> · <%= sk.teacher.name %> 老师
        </p>
      </div>
      <span class="badge badge-outline badge-secondary badge-sm shrink-0"><%= SemesterKlass::GENRE_MAP_REVERSE[sk.genre] %></span>
    </div>
    <div class="mt-3 grid grid-cols-2 gap-2 text-xs">
      <div class="rounded-box bg-base-200/60 p-2.5">
        <p class="text-base-content/50">在班学员</p>
        <p class="mt-0.5 text-lg font-semibold"><%= row.active_count %> 人</p>
      </div>
      <div class="rounded-box bg-base-200/60 p-2.5">
        <p class="text-base-content/50">学期</p>
        <p class="mt-0.5 font-medium"><%= sk.semester.name %></p>
      </div>
    </div>
  </div>

  <div class="wt-surface p-4">
    <h3 class="text-sm font-semibold">学员构成</h3>
    <div class="mt-3 space-y-3.5">
      <% [
        [ "新增", row.new_count, row.new_rate, row.new_students, "bg-accent" ],
        [ "拓科", row.expand_count, row.expand_rate, row.expand_students, "bg-secondary" ],
        [ "预留", row.reserve_count, row.reserve_rate, row.reserve_students, "bg-primary" ]
      ].each do |label, count, rate, students, color| %>
        <% pct = (rate * 100).round(1) %>
        <div>
          <div class="flex items-center justify-between text-xs">
            <span class="font-medium"><%= label %> <span class="font-normal text-base-content/50"><%= count %> / <%= row.active_count %></span></span>
            <span class="font-semibold"><%= pct %>%</span>
          </div>
          <div class="mt-1 h-1 w-full rounded-full bg-base-200">
            <span class="block h-1 rounded-full <%= color %>" style="width: <%= pct.clamp(0, 100) %>%"></span>
          </div>
          <% if students.any? %>
            <div class="mt-1.5 flex flex-wrap gap-1">
              <% students.each do |name| %>
                <span class="badge badge-ghost badge-xs"><%= name %></span>
              <% end %>
            </div>
          <% else %>
            <p class="mt-1 text-[11px] text-base-content/40">无</p>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>

  <div class="wt-surface p-4">
    <div class="flex items-center justify-between gap-2">
      <h3 class="text-sm font-semibold">在班名单</h3>
      <span class="text-xs text-base-content/50">共 <%= row.active_count %> 人</span>
    </div>
    <% if row.active_students.any? %>
      <div class="mt-2 flex max-h-56 flex-wrap gap-1 overflow-y-auto">
        <% row.active_students.each do |name| %>
          <span class="badge badge-ghost badge-sm"><%= name %></span>
        <% end %>
      </div>
    <% else %>
      <p class="mt-2 text-xs text-base-content/40">该班级暂无在班学员</p>
    <% end %>
  </div>
</div>
