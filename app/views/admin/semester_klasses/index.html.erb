<% content_for :page_title, "班级管理" %>
<% content_for :page_subtitle, "#{Current.semester&.name} · #{Current.campuse&.name} · 共 #{@sks.size} 个班级" %>
<% content_for :page_actions do %>
  <%= render "admin/shared/drawer", item: SemesterKlass.new, drawer_id: "drawer-klass-new", button_name: "开班", drawer_width: "240", drawer_content: "admin/semester_klasses/form" %>
  <%= link_to export_attendances_admin_semester_klasses_path, class: "btn btn-xs btn-outline btn-primary", title: "导出当前学期全部班级考勤", data: { turbo: false } do %>
    <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3" /></svg>
    导出考勤
  <% end %>
  <%= link_to "复制班级", copy_admin_semester_klasses_path, class: "btn btn-xs btn-outline btn-primary" %>
<% end %>

<div class="mb-5 grid gap-3 sm:grid-cols-2 xl:grid-cols-4">
  <div class="wt-surface p-4">
    <p class="text-xs text-base-content/50">班级</p>
    <p class="mt-1 text-2xl font-semibold"><%= @sks.size %><span class="ml-1 text-sm font-normal text-base-content/50">个</span></p>
    <p class="mt-2 h-1 w-full rounded-full bg-primary/20"><span class="block h-1 w-full rounded-full bg-primary"></span></p>
  </div>
  <div class="wt-surface p-4">
    <p class="text-xs text-base-content/50">在班学员</p>
    <p class="mt-1 text-2xl font-semibold"><%= @active_counts.values.sum %><span class="ml-1 text-sm font-normal text-base-content/50">人</span></p>
    <p class="mt-2 h-1 w-full rounded-full bg-secondary/20"><span class="block h-1 w-3/4 rounded-full bg-secondary"></span></p>
  </div>
  <div class="wt-surface p-4">
    <p class="text-xs text-base-content/50">已开课次</p>
    <p class="mt-1 text-2xl font-semibold"><%= @started_courses %><span class="ml-1 text-sm font-normal text-base-content/50">/ <%= @total_courses %></span></p>
    <p class="mt-2 h-1 w-full rounded-full bg-success/20">
      <span class="block h-1 rounded-full bg-success" style="width: <%= @total_courses.zero? ? 0 : (@started_courses * 100 / @total_courses) %>%"></span>
    </p>
  </div>
  <div class="wt-surface p-4">
    <p class="text-xs text-base-content/50">待开课次</p>
    <p class="mt-1 text-2xl font-semibold"><%= @total_courses - @started_courses %><span class="ml-1 text-sm font-normal text-base-content/50">节</span></p>
    <p class="mt-2 h-1 w-full rounded-full bg-warning/20"><span class="block h-1 w-1/2 rounded-full bg-warning"></span></p>
  </div>
</div>

<% @grade_groups.each do |grade, sks| %>
  <section class="mb-6">
    <div class="mb-2.5 flex flex-wrap items-center gap-2">
      <h2 class="text-sm font-semibold"><%= grade.name %></h2>
      <span class="badge badge-ghost badge-sm"><%= sks.size %> 个班</span>
      <span class="text-xs text-base-content/50">在班 <%= sks.sum { |sk| @active_counts.fetch(sk.id, 0) } %> 人</span>
    </div>

    <div class="grid gap-3 sm:grid-cols-2 xl:grid-cols-3 2xl:grid-cols-4">
      <% sks.each do |sk| %>
        <% active = @active_counts.fetch(sk.id, 0) %>
        <% reserve_pct = (@reserve_rates.fetch(sk.id, 0.0) * 100).round(1) %>
        <% started = sk.courses.count(&:started?) %>
        <% total = sk.times.to_i %>
        <%= link_to admin_semester_klass_path(sk), class: "wt-surface group block p-4 transition hover:border-primary/40" do %>
          <div class="flex items-start justify-between gap-2">
            <div class="min-w-0">
              <p class="text-base font-semibold"><%= sk.name %></p>
              <p class="mt-0.5 truncate text-xs text-base-content/50"><%= sk.subject.name %> · <%= sk.teacher.name %> 老师</p>
            </div>
            <span class="badge badge-outline badge-secondary badge-sm shrink-0"><%= SemesterKlass::GENRE_MAP_REVERSE[sk.genre] %></span>
          </div>

          <div class="mt-3 flex flex-wrap items-center justify-between gap-x-2 gap-y-1 text-xs text-base-content/60">
            <span>在班 <span class="font-semibold text-base-content"><%= active %></span> 人</span>
            <span>预留率 <span class="font-semibold text-primary"><%= reserve_pct %>%</span></span>
            <span>已开 <%= started %>/<%= total %> 课</span>
          </div>
          <div class="mt-2 h-1 w-full rounded-full bg-base-200">
            <span class="block h-1 rounded-full bg-primary" style="width: <%= total.zero? ? 0 : (started * 100 / total) %>%"></span>
          </div>

          <p class="mt-3 flex items-center gap-1 text-xs text-base-content/40 transition group-hover:text-primary">
            进入考勤
            <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
          </p>
        <% end %>
      <% end %>
    </div>
  </section>
<% end %>

<% if @sks.empty? %>
  <div class="wt-surface flex flex-col items-center gap-2 p-12 text-center">
    <span class="flex h-12 w-12 items-center justify-center rounded-full bg-base-200 text-base-content/40">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zm10 0a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zm10 0a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z" /></svg>
    </span>
    <p class="text-sm font-medium">当前学期还没有班级</p>
    <p class="text-xs text-base-content/50">点击右上角「开班」创建，或从历史学期复制一个班级。</p>
    <%= link_to "复制班级", copy_admin_semester_klasses_path, class: "btn btn-sm btn-outline btn-primary mt-1" %>
  </div>
<% end %>

<%= render "admin/shared/quick_student_modal" %>
