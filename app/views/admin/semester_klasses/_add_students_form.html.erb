<% join_options = @courses.map { |course| [ "第 #{course.seq} 课#{course.started? ? "（已开课）" : ""}", course.seq ] } %>
<% default_seq = @next_course&.seq || @courses.last&.seq || 1 %>
<%= form_with url: insert_students_admin_semester_klass_path(@sk), method: :post,
      namespace: "add_students", local: true, class: "space-y-4" do |form| %>
  <div class="wt-surface p-4">
    <h3 class="text-sm font-semibold">添加学员 · <%= @sk.name %></h3>
    <p class="mt-1 text-xs text-base-content/50">
      <%= @sk.grade.name %> · <%= @sk.subject.name %> · <%= @sk.teacher.name %> 老师
    </p>

    <div class="mt-3">
      <%= form.label :join_course_seq, "入班课次", class: "mb-1 block text-xs font-medium text-base-content/60" %>
      <%= form.select :join_course_seq, join_options, { selected: default_seq },
            { class: "select select-sm w-full", required: true } %>
      <p class="mt-1 text-[11px] leading-snug text-base-content/40">从该课次开始加入，之前课次补记为缺课。</p>
    </div>
  </div>

  <div class="wt-surface p-4">
    <div class="flex items-center justify-between gap-2">
      <h3 class="text-sm font-semibold">选择学员</h3>
      <span class="text-xs text-base-content/50">共 <%= @insert_student_candidates.size %> 人可选</span>
    </div>
    <p class="mt-1 text-xs text-base-content/50">只列出本班同年级、尚未加入本班的学员。</p>

    <%= render "admin/shared/student_multiselect",
          options: @insert_student_candidates.map { |student| { student: student, checked: false, badge: nil } },
          id_prefix: "add_students",
          hint: "所选学员从入班课次开始加入，之前课次补记为缺课。",
          empty_message: "没有可添加的学员，请先在学员管理中建档或检查年级。" %>
  </div>

  <%= form.submit "添加学员", class: "btn btn-primary w-full", disabled: @insert_student_candidates.empty? %>
<% end %>
