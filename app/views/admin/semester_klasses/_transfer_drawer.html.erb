<%# 转出引导抽屉：由考勤卡上的「转出」按钮打开，提交到目标班级 %>
<% subjects = target_klasses.map(&:subject).uniq.sort_by(&:name) %>
<% genres = target_klasses.map(&:genre).uniq.sort %>
<div class="drawer drawer-end">
  <input id="drawer-transfer" type="checkbox" class="drawer-toggle" data-transfer-drawer-target="toggle" />
  <div class="drawer-content"></div>
  <div class="drawer-side z-50">
    <label for="drawer-transfer" aria-label="close sidebar" class="drawer-overlay"></label>
    <div class="bg-base-200 min-h-full p-4 sm:p-6" style="width: min(calc(var(--spacing) * 260), 92vw)">
      <%= form_with url: "#", method: :put, class: "flex flex-col gap-4",
            data: { transfer_drawer_target: "form" } do |form| %>
        <div>
          <h2 class="text-base font-semibold">转出学员</h2>
          <p class="mt-1 text-xs text-base-content/60" data-transfer-drawer-target="summary">请选择要转入的班级。</p>
        </div>

        <div class="wt-surface p-4">
          <div class="mb-3 grid grid-cols-2 gap-2">
            <div>
              <label for="transfer_subject_filter" class="mb-1 block text-xs text-base-content/60">科目</label>
              <select id="transfer_subject_filter" class="select select-sm w-full"
                      data-transfer-drawer-target="subjectFilter"
                      data-action="change->transfer-drawer#applyFilters">
                <option value="">全部科目</option>
                <% subjects.each do |subject| %>
                  <option value="<%= subject.id %>"><%= subject.name %></option>
                <% end %>
              </select>
            </div>
            <div>
              <label for="transfer_genre_filter" class="mb-1 block text-xs text-base-content/60">班型</label>
              <select id="transfer_genre_filter" class="select select-sm w-full"
                      data-transfer-drawer-target="genreFilter"
                      data-action="change->transfer-drawer#applyFilters">
                <option value="">全部班型</option>
                <% genres.each do |genre| %>
                  <option value="<%= genre %>"><%= SemesterKlass::GENRE_MAP_REVERSE[genre] %></option>
                <% end %>
              </select>
            </div>
          </div>

          <p class="mb-2 text-xs font-semibold text-base-content/60">转入班级</p>
          <div class="space-y-2">
            <% target_klasses.each do |target| %>
              <label data-transfer-drawer-target="option"
                     data-class-id="<%= target.id %>"
                     data-subject-id="<%= target.subject_id %>"
                     data-genre="<%= target.genre %>"
                     class="flex cursor-pointer items-start gap-2 rounded-box border border-base-300 bg-base-100 p-2 transition hover:bg-base-200/60">
                <%= form.radio_button :target_semester_klass_id, target.id, class: "radio radio-sm mt-0.5", required: true %>
                <span class="min-w-0">
                  <span class="block text-sm font-medium"><%= target.name %></span>
                  <span class="block text-[11px] text-base-content/50">
                    <%= target.subject.name %> · <%= SemesterKlass::GENRE_MAP_REVERSE[target.genre] %> ·
                    <%= target.teacher.name %> 老师 · 在班 <%= target_counts[target.id].to_i %> 人
                  </span>
                </span>
              </label>
            <% end %>
          </div>

          <p class="mt-2 hidden text-xs text-base-content/50" data-transfer-drawer-target="empty">
            没有符合条件的班级；该学员已在的班级不会显示。
          </p>
        </div>

        <p class="text-[11px] leading-snug text-base-content/40">
          转出后学员保留在本班列表并标记为「转出」；转入目标班后从转出课次的下一课起上课（不早于目标班首个未开课课次），之前的课次标记为「转入」（源班考勤保留在源班）。
        </p>

        <div class="flex justify-end gap-2">
          <label for="drawer-transfer" class="btn btn-ghost">取消</label>
          <%= form.submit "确认转出", class: "btn btn-primary",
                data: { transfer_drawer_target: "submit" }, disabled: target_klasses.empty? %>
        </div>
      <% end %>
    </div>
  </div>
</div>
