<% content_for :page_title, "班级预留报表" %>
<% content_for :page_subtitle, "预留汇总 · 共 #{@summary[:class_count]} 个班级" %>
<% content_for :breadcrumb do %><span>班级预留报表</span><% end %>
<% content_for :page_actions do %>
  <%= link_to export_statement_admin_semester_klasses_path(q: params[:q]&.to_unsafe_h), class: "btn btn-xs btn-outline btn-primary", data: { turbo: false } do %>
    <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3" /></svg>
    导出报表
  <% end %>
  <%= render "admin/shared/drawer", item: Current.campuse, drawer_id: "drawer-reserve-setting",
        button_name: "预留设置", button_class: "btn btn-xs btn-outline btn-primary",
        drawer_width: "180", drawer_content: "admin/semester_klasses/reserve_setting_form" %>

  <%= link_to "复制班级", copy_admin_semester_klasses_path, class: "btn btn-xs btn-outline btn-primary" %>
<% end %>

<%
  metrics = [
    [ "预留", :reserve_count, :reserve_rate, :reserve_students, "bg-primary" ]
  ]
%>

<div class="mb-4 flex flex-wrap items-center gap-x-2 gap-y-1 rounded-box border border-primary/20 bg-primary/5 px-4 py-3 text-xs text-base-content/60">
  <span class="badge badge-soft badge-primary badge-sm">口径</span>
  <span><b class="text-base-content/80">预留</b>：下学期同科目班上课 ≥ <%= @reserve_min_attendances %> 次（达标后退课 / 转出的仍计入）</span>
</div>

<div class="mb-5 grid gap-3 sm:grid-cols-2 xl:grid-cols-3">
  <div class="wt-surface p-4">
    <p class="text-xs text-base-content/50">统计班级</p>
    <p class="mt-1 text-2xl font-semibold"><%= @summary[:class_count] %><span class="ml-1 text-sm font-normal text-base-content/50">个</span></p>
    <p class="mt-2 h-1 w-full rounded-full bg-primary/20"><span class="block h-1 w-full rounded-full bg-primary"></span></p>
  </div>
  <div class="wt-surface p-4">
    <p class="text-xs text-base-content/50">在班学员</p>
    <p class="mt-1 text-2xl font-semibold"><%= @summary[:active_count] %><span class="ml-1 text-sm font-normal text-base-content/50">人次</span></p>
    <p class="mt-2 h-1 w-full rounded-full bg-secondary/20"><span class="block h-1 w-2/3 rounded-full bg-secondary"></span></p>
  </div>
  <div class="wt-surface p-4">
    <p class="text-xs text-base-content/50">平均预留率</p>
    <p class="mt-1 text-2xl font-semibold"><%= @summary[:reserve_rate] %><span class="ml-0.5 text-sm font-normal text-base-content/50">%</span></p>
    <p class="mt-2 h-1 w-full rounded-full bg-primary/20"><span class="block h-1 rounded-full bg-primary" style="width: <%= @summary[:reserve_rate].clamp(0, 100) %>%"></span></p>
  </div>
</div>

<%= render "admin/semester_klasses/filter_form", form_url: statement_admin_semester_klasses_path %>

<div class="wt-surface mt-4 overflow-x-auto">
  <table class="table table-sm">
    <thead class="bg-base-200/60 text-xs uppercase tracking-wide text-base-content/60">
      <tr>
        <th class="w-12">#</th>
        <th>学期</th>
        <th>年级</th>
        <th>科目</th>
        <th>教师</th>
        <th>班型</th>
        <th>班级</th>
        <th>人数</th>
        <th>预留率</th>
        <th class="text-right">详情</th>
      </tr>
    </thead>
    <tbody>
      <% @rows.each.with_index(1) do |row, index| %>
        <% sk = row.semester_klass %>
        <tr class="hover:bg-base-200/40">
          <td class="text-base-content/40"><%= index %></td>
          <td><span class="badge badge-ghost badge-sm whitespace-nowrap"><%= sk.semester.name %></span></td>
          <td><span class="badge badge-ghost badge-sm"><%= sk.grade.name %></span></td>
          <td class="font-medium"><%= sk.subject.name %></td>
          <td class="text-base-content/70"><%= sk.teacher.name %></td>
          <td class="text-base-content/70"><%= SemesterKlass::GENRE_MAP_REVERSE[sk.genre] %></td>
          <td><span class="badge badge-outline badge-primary badge-sm font-semibold"><%= sk.name %></span></td>
          <td class="font-semibold"><%= row.active_count %><span class="ml-0.5 text-xs font-normal text-base-content/50">人</span></td>
          <% metrics.each do |label, count_method, rate_method, _, color| %>
            <% pct = (row.public_send(rate_method) * 100).round(1) %>
            <% count = row.public_send(count_method) %>
            <td title="<%= label %> <%= count %> / 在班 <%= row.active_count %>">
              <div class="flex items-center gap-2">
                <span class="h-1.5 w-12 shrink-0 overflow-hidden rounded-full bg-base-200">
                  <span class="block h-full rounded-full <%= color %>" style="width: <%= pct.clamp(0, 100) %>%"></span>
                </span>
                <span class="flex flex-col leading-tight">
                  <span class="text-xs font-medium"><%= pct %>%</span>
                  <span class="text-[10px] text-base-content/40"><%= count %>/<%= row.active_count %></span>
                </span>
              </div>
            </td>
          <% end %>
          <td class="text-right">
            <%= render "admin/shared/drawer", item: sk,
                  drawer_id: "statement-drawer-#{sk.id}",
                  button_name: "详情",
                  drawer_width: "240",
                  drawer_content: "admin/semester_klasses/statement_detail",
                  drawer_locals: { row: row } %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <% if @rows.empty? %>
    <div class="p-12 text-center text-sm text-base-content/50">当前筛选条件下没有班级数据</div>
  <% end %>
</div>
