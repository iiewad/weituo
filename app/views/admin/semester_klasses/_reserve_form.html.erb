<% if @next_semester.blank? %>
  <div class="wt-surface p-4">
    <h3 class="text-sm font-semibold">预留下学期</h3>
    <p class="mt-1 text-xs text-base-content/50">下学期尚未创建，请先到学校管理中创建学期。</p>
  </div>
<% elsif @reserve_candidates.empty? %>
  <div class="wt-surface p-4">
    <h3 class="text-sm font-semibold">预留下学期</h3>
    <p class="mt-1 text-xs text-base-content/50">当前班级没有可预留的学员（可能已全部预留）。</p>
  </div>
<% else %>
  <%= form_with url: reserve_admin_semester_klass_path(@sk), method: :post,
        namespace: "reserve", local: true, class: "space-y-4" do |form| %>
    <div class="wt-surface p-4">
      <h3 class="text-sm font-semibold">预留下学期 · <%= @next_semester.name %></h3>
      <p class="mt-1 text-xs text-base-content/50">
        <%= @sk.name %> · <%= @sk.grade.name %> · <%= @sk.subject.name %> · 可换班型 / 教师 / 升年级
      </p>

      <div class="mt-3 space-y-2">
        <p class="text-xs font-medium text-base-content/60">目标班级</p>
        <% @reserve_targets.each do |target| %>
          <label class="flex cursor-pointer items-start gap-2 rounded-box border border-base-300 bg-base-100 p-2">
            <%= form.radio_button :target_semester_klass_id, target.id, checked: @reserve_targets.first == target,
                  class: "radio radio-sm mt-0.5" %>
            <span class="min-w-0">
              <span class="block text-sm font-medium"><%= target.grade.name %> · <%= target.name %></span>
              <span class="block text-[11px] text-base-content/50">
                <%= SemesterKlass::GENRE_MAP_REVERSE[target.genre] %> · <%= target.teacher.name %> 老师 ·
                在班 <%= target.klass_students.where(status: "in").count %> 人
              </span>
            </span>
          </label>
        <% end %>
        <label class="flex cursor-pointer items-center gap-2 rounded-box border border-base-300 bg-base-100 p-2">
          <%= form.radio_button :target_semester_klass_id, "", checked: @reserve_targets.empty?, class: "radio radio-sm" %>
          <span class="text-sm font-medium">新建班级</span>
        </label>
      </div>

      <div class="mt-3 grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-4">
        <div>
          <%= form.label :new_grade_id, "年级", class: "mb-1 block text-xs text-base-content/60" %>
          <%= form.select :new_grade_id, @reserve_grades.map { |grade| [ grade.name, grade.id ] },
                { selected: @reserve_default_grade.id }, { class: "select select-sm w-full" } %>
        </div>
        <div>
          <%= form.label :new_genre, "班型", class: "mb-1 block text-xs text-base-content/60" %>
          <%= form.select :new_genre, SemesterKlass::GENRE_MAP.map { |name, code| [ name, code ] },
                { selected: @sk.genre }, { class: "select select-sm w-full" } %>
        </div>
        <div>
          <%= form.label :new_teacher_id, "教师", class: "mb-1 block text-xs text-base-content/60" %>
          <%= form.select :new_teacher_id, @reserve_teachers.map { |teacher| [ teacher.name, teacher.id ] },
                { selected: @sk.teacher_id }, { class: "select select-sm w-full" } %>
        </div>
        <div>
          <%= form.label :new_times, "课次", class: "mb-1 block text-xs text-base-content/60" %>
          <%= form.number_field :new_times, value: @reserve_default_times, min: 1, class: "input input-sm w-full" %>
        </div>
      </div>
      <p class="mt-1 text-[11px] leading-snug text-base-content/40">
        选择「新建班级」时使用以上设置；班级序号自动生成。目标年级高于学员现年级时，确认后会同步升年级。
      </p>
    </div>

    <div class="wt-surface p-4">
      <div class="flex items-center justify-between gap-2">
        <h3 class="text-sm font-semibold">选择学员</h3>
        <span class="text-xs text-base-content/50">共 <%= @reserve_candidates.size %> 人可选</span>
      </div>
      <p class="mt-1 text-xs text-base-content/50">已在下学期同科目班级的学员不再显示。</p>
      <div class="mt-2 max-h-64 space-y-1 overflow-y-auto">
        <% @reserve_candidates.each do |klass_student| %>
          <label class="flex items-center gap-2 rounded-box px-2.5 py-1.5 text-xs hover:bg-base-200/60">
            <%= check_box_tag "student_ids[]", klass_student.student_id, true, class: "checkbox checkbox-xs" %>
            <span class="font-medium"><%= klass_student.student.identity_label %></span>
            <span class="ml-auto text-[10px] text-base-content/40"><%= klass_student.student.grade&.name %></span>
          </label>
        <% end %>
      </div>
    </div>

    <%= form.submit "确认预留", class: "btn btn-primary w-full" %>
  <% end %>
<% end %>
