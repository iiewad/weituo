<%= form_with model: item,
      url: item.new_record? ? admin_semester_klasses_path : admin_semester_klass_path(item),
      method: item.new_record? ? :post : :put,
      namespace: "klass_#{item.id || 'new'}",
      local: true,
      class: "space-y-4" do |form| %>
  <%= form.hidden_field :semester_id, value: Thread.current[:semester].id %>
  <%= form.hidden_field :campuse_id, value: Thread.current[:campuse].id %>

  <div class="wt-surface p-4">
    <h3 class="text-sm font-semibold"><%= item.new_record? ? "开班" : "班级详情 · #{item.name}" %></h3>
    <p class="mt-1 text-xs text-base-content/50">
      <%= item.new_record? ? "创建后自动按课次排课，并可从名单导入学员。" : "修改班级信息会同步更新班级名称与课次。" %>
    </p>

    <% if item.persisted? %>
      <div class="mt-3 rounded-box border border-base-300 bg-base-200/50 p-3">
        <div class="flex flex-wrap items-center gap-1.5">
          <span class="badge badge-ghost badge-sm"><%= item.semester.name %></span>
          <span class="font-medium"><%= item.name %></span>
          <span class="text-xs text-base-content/50"><%= SemesterKlass::GENRE_MAP_REVERSE[item.genre] %></span>
        </div>
        <p class="mt-1.5 text-xs text-base-content/60">
          <%= item.grade.name %> · <%= item.subject.name %> · <%= item.teacher.name %> 老师
        </p>
        <p class="mt-1 text-xs text-base-content/50">
          共 <%= item.times %> 课次 · 在班 <%= item.current_active_students.count %> 人 · 名单 <%= item.students.size %> 人
        </p>
      </div>
    <% end %>
  </div>

  <div class="wt-surface p-4">
    <div class="mb-3 flex flex-wrap items-center gap-2 text-xs">
      <span class="text-base-content/50">目标学期</span>
      <span class="badge badge-soft badge-primary badge-sm"><%= Thread.current[:semester]&.name %></span>
      <span class="text-base-content/50">·</span>
      <span class="text-base-content/50"><%= Thread.current[:campuse]&.name %></span>
    </div>

    <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
      <div>
        <%= form.label :genre, "班型", class: "mb-1 block text-xs font-medium text-base-content/60" %>
        <%= form.select :genre, SemesterKlass::GENRE_MAP.map { |name, code| [ name, code ] },
              { selected: item.genre.presence || "TG" }, { class: "select select-sm w-full", required: true } %>
      </div>

      <div>
        <%= form.label :seq, "班级序号", class: "mb-1 block text-xs font-medium text-base-content/60" %>
        <%= form.number_field :seq, value: item.seq, min: 1, class: "input input-sm w-full", required: true,
              oninput: "this.value = this.value.replace(/4/g, '')" %>
        <p class="mt-1 text-[11px] leading-tight text-base-content/40">序号不可含 4，避免同科目班型冲突。</p>
      </div>

      <div>
        <%= form.label :grade_id, "年级", class: "mb-1 block text-xs font-medium text-base-content/60" %>
        <%= form.select :grade_id,
              Current.user.grades_by_campuse(Thread.current[:campuse].id).includes(:subjects).map { |grade| [ grade.name, grade.id ] },
              { include_blank: "选择年级", selected: item.grade_id }, { class: "select select-sm w-full", required: true } %>
      </div>

      <div>
        <%= form.label :teacher_id, "教师", class: "mb-1 block text-xs font-medium text-base-content/60" %>
        <%= form.select :teacher_id, option_groups_from_collection_for_select(Subject.all, :teachers, :name, :id, :name, item.teacher_id),
              { include_blank: "选择教师" }, { class: "select select-sm w-full", required: true } %>
        <p class="mt-1 text-[11px] leading-tight text-base-content/40">科目由所选教师自动带出。</p>
      </div>

      <div class="sm:col-span-2">
        <%= form.label :times, "课次", class: "mb-1 block text-xs font-medium text-base-content/60" %>
        <%= form.number_field :times, value: item.times, min: 1, class: "input input-sm w-full", placeholder: "例如：16", required: true %>
      </div>
    </div>
  </div>

  <div class="wt-surface p-4">
    <div class="flex items-center justify-between gap-2">
      <h3 class="text-sm font-semibold">学员名单</h3>
      <span class="text-xs text-base-content/50">按姓名匹配当前年级</span>
    </div>
    <p class="mt-1 text-xs text-base-content/50">每行一个姓名；插班写「姓名 课次+」，例如：张三 4+。匹配不到的姓名会被忽略。</p>
    <%= form.text_area :students_text, value: item.new_record? ? "" : item.students_text,
          class: "textarea textarea-sm mt-2 h-56 w-full font-mono text-xs leading-5",
          placeholder: "张三\n李四 4+" %>
  </div>

  <%= form.submit item.new_record? ? "开班" : "保存修改", class: "btn btn-primary w-full" %>
<% end %>
