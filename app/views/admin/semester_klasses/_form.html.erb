<%= form_with model: item,
      url: item.new_record? ? admin_semester_klasses_path : admin_semester_klass_path(item),
      method: item.new_record? ? :post : :put,
      namespace: "klass_#{item.id || 'new'}",
      local: true,
      class: "space-y-4",
      data: {
        controller: "klass-times",
        klass_times_times_value: (@grade_subject_times || {}).to_json,
        klass_times_subjects_value: (@teacher_subjects || {}).to_json
      } do |form| %>
  <%= form.hidden_field :semester_id, value: Current.semester.id %>
  <%= form.hidden_field :campuse_id, value: Current.campuse.id %>
  <% existing_klass_students = item.persisted? ? item.klass_students.includes(:student).to_a : [] %>
  <% grade_locked = item.persisted? && item.all_klass_students.exists? %>
  <% phase_locked = grade_locked %>

  <div class="wt-surface p-4">
    <h3 class="text-sm font-semibold"><%= item.new_record? ? "开班" : "班级详情 · #{item.name}" %></h3>
    <p class="mt-1 text-xs text-base-content/50">
      <%= item.new_record? ? "创建后自动按课次排课，并可勾选学员入班。" : "修改班级信息会同步更新班级名称与课次，可在下方追加学员。" %>
    </p>

    <% if item.persisted? %>
      <div class="mt-3 rounded-box border border-base-300 bg-base-200/50 p-3">
        <div class="flex flex-wrap items-center gap-1.5">
          <span class="badge badge-ghost badge-sm"><%= item.semester.name %></span>
          <span class="font-medium"><%= item.name %></span>
          <span class="text-xs text-base-content/50"><%= SemesterKlass::GENRE_MAP_REVERSE[item.genre] %></span>
        </div>
        <p class="mt-1.5 text-xs text-base-content/60">
          <%= item.grade.name %> · <%= item.subject.name %> · <%= item.teacher.name %> 老师
        </p>
        <p class="mt-1 text-xs text-base-content/50">
          共 <%= item.times %> 课次 · 在班 <%= existing_klass_students.count { |klass_student| klass_student.status == "in" } %> 人 · 名单 <%= existing_klass_students.size %> 人
        </p>
      </div>
    <% end %>
  </div>

  <div class="wt-surface p-4">
    <div class="mb-3 flex flex-wrap items-center gap-2 text-xs">
      <span class="text-base-content/50">目标学期</span>
      <span class="badge badge-soft badge-primary badge-sm"><%= Current.semester&.name %></span>
      <span class="text-base-content/50">·</span>
      <span class="text-base-content/50"><%= Current.campuse&.name %></span>
    </div>

    <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
      <%# 年级为按钮组：只列出当前账号在本校区负责的年级，新建时默认选中序号最靠前的年级 %>
      <% grades = Current.user.grades_by_campuse(Current.campuse.id).order(:level).to_a %>
      <% grades << item.grade if item.grade && grades.none? { |grade| grade.id == item.grade_id } %>
      <% selected_grade_id = item.grade_id || grades.first&.id %>
      <div>
        <span class="mb-1 block text-xs font-medium text-base-content/60">年级</span>
        <div id="klass_<%= item.id || "new" %>_semester_klass_grade_id" class="flex flex-wrap gap-1.5">
          <% grades.each do |grade| %>
            <%= form.radio_button :grade_id, grade.id,
                  checked: grade.id == selected_grade_id, disabled: grade_locked, class: "btn btn-xs",
                  aria: { label: grade.name }, required: grade == grades.first,
                  data: { klass_times_target: "grade", action: "change->klass-times#apply" } %>
          <% end %>
        </div>
        <% if grade_locked %>
          <p class="mt-1 text-[11px] leading-tight text-base-content/40">班级已有学员，年级不可修改。</p>
        <% end %>
      </div>

      <%# 教师：可搜索选择器，输入姓名或科目过滤；真实的 select 由 search-select 控制器隐藏并写回 %>
      <div data-controller="search-select">
        <label for="klass_<%= item.id || "new" %>_teacher_search" class="mb-1 block text-xs font-medium text-base-content/60">教师</label>
        <%= form.select :teacher_id, grouped_options_for_select(@teacher_groups || [], item.teacher_id),
              { include_blank: "选择教师" },
              { class: "select select-sm w-full",
                data: { klass_times_target: "teacher", action: "change->klass-times#apply", search_select_target: "select" } } %>
        <div class="relative">
          <input type="text" id="klass_<%= item.id || "new" %>_teacher_search" class="input input-sm w-full"
                 autocomplete="off" placeholder="输入教师姓名或科目搜索" required
                 data-search-select-target="input"
                 data-action="focus->search-select#open input->search-select#filter keydown->search-select#keydown blur->search-select#close">
          <div class="absolute z-30 mt-1 hidden max-h-48 w-full overflow-y-auto rounded-box border border-base-300 bg-base-100 p-1 shadow-lg"
               data-search-select-target="results" data-action="pointerdown->search-select#pick"></div>
        </div>
        <p class="mt-1 text-[11px] leading-tight text-base-content/40">科目由所选教师自动带出。</p>
      </div>

      <div>
        <span class="mb-1 block text-xs font-medium text-base-content/60">班型</span>
        <div class="flex flex-wrap gap-1.5">
          <% SemesterKlass::GENRE_MAP.each do |name, code| %>
            <%= form.radio_button :genre, code, checked: (item.genre.presence || "TG") == code,
                  aria: { label: name }, required: code == SemesterKlass::GENRE_MAP["提高班"],
                  class: "btn btn-xs" %>
          <% end %>
        </div>
      </div>

      <div>
        <span class="mb-1 block text-xs font-medium text-base-content/60">阶段</span>
        <div class="flex flex-wrap gap-1.5">
          <% SemesterKlass::PHASE_MAP.each do |value, label| %>
            <%= form.radio_button :phase, value, checked: (item.phase || 1) == value, disabled: phase_locked,
                  aria: { label: label }, required: value == 1, class: "btn btn-xs" %>
          <% end %>
        </div>
        <% if phase_locked %>
          <p class="mt-1 text-[11px] leading-tight text-base-content/40">班级已有学员，阶段不可修改。</p>
        <% else %>
          <p class="mt-1 text-[11px] leading-tight text-base-content/40">同一学期两个阶段可重复使用班型与序号，默认第一阶段。</p>
        <% end %>
      </div>

      <div>
        <%= form.label :seq, "班级序号", class: "mb-1 block text-xs font-medium text-base-content/60" %>
        <% if item.new_record? %>
          <p class="pt-1 text-xs text-base-content/50">保存时自动生成，跳过含 4 的序号</p>
        <% else %>
          <%= form.number_field :seq, min: 1, class: "input input-sm w-full",
                oninput: "this.value = this.value.replace(/4/g, '')" %>
          <p class="mt-1 text-[11px] leading-tight text-base-content/40">可修改；序号不含 4，且同年级 / 科目 / 班型 / 阶段下不可重复。</p>
        <% end %>
      </div>

      <div class="sm:col-span-2">
        <%= form.label :times, "课次", class: "mb-1 block text-xs font-medium text-base-content/60" %>
        <%= form.number_field :times, value: item.times, min: 1, class: "input input-sm w-full",
              placeholder: "默认使用年级科目配置", data: { klass_times_target: "times" } %>
        <p class="mt-1 text-[11px] leading-tight text-base-content/40">
          留空时按当前学期的年级科目课次设置；修改后会自动补齐或删除未开课的课次，已开课的课次不能减少。
        </p>
      </div>
    </div>
  </div>

  <% enrolled_ids = existing_klass_students.map(&:student_id) %>
  <% candidates = (@new_class_candidates || []).reject { |student| enrolled_ids.include?(student.id) } %>

  <div class="wt-surface p-4" data-controller="student-add-mode" data-action="change->student-add-mode#apply">
    <div class="flex items-center justify-between gap-2">
      <h3 class="text-sm font-semibold">学员名单</h3>
      <span class="text-xs text-base-content/50">共 <%= candidates.size %> 人可选</span>
    </div>

    <div class="mt-2 flex flex-wrap items-end gap-3">
      <div class="w-32">
        <label class="mb-1 block text-[11px] font-medium text-base-content/50">入班课次</label>
        <%= number_field_tag :join_course_seq, 1, min: 1, class: "input input-sm w-full" %>
      </div>
      <div class="flex flex-wrap items-center gap-4 pb-2 text-xs text-base-content/70">
        <label class="flex cursor-pointer items-center gap-1.5">
          <input type="radio" name="student_add_mode_<%= item.id || "new" %>" value="pick" class="radio radio-xs" checked>
          <span>勾选学员</span>
        </label>
        <label class="flex cursor-pointer items-center gap-1.5">
          <input type="radio" name="student_add_mode_<%= item.id || "new" %>" value="text" class="radio radio-xs">
          <span>粘贴名单</span>
        </label>
      </div>
    </div>
    <p class="mt-1 text-[11px] leading-snug text-base-content/40">勾选学员按此课次入班；粘贴名单里未写课次的行也使用此值。</p>

    <div class="mt-2 hidden" data-student-add-mode-target="text">
      <label for="klass_<%= item.id || "new" %>_students_text" class="mb-1 block text-[11px] font-medium text-base-content/50">粘贴名单（每行：姓名,入班课次）</label>
      <textarea id="klass_<%= item.id || "new" %>_students_text" name="students_text" rows="6"
                class="textarea textarea-sm w-full font-mono text-xs leading-5"
                placeholder="张三,1&#10;李四,3"></textarea>
      <p class="mt-1 text-[11px] leading-snug text-base-content/40">每行一位学员，课次可省略；没有档案的姓名会按本班年级自动建档，已在班或重复的行会跳过。</p>
    </div>

    <div data-student-add-mode-target="picked">
    <p class="mt-2 text-xs text-base-content/50">搜索并勾选要加入本班的学员；已入班学员不会重复出现。</p>

    <% if item.persisted? && existing_klass_students.any? %>
      <details class="mt-2 rounded-box border border-base-300 bg-base-100">
        <summary class="cursor-pointer px-3 py-2 text-xs font-medium">当前学员 <%= existing_klass_students.size %> 人</summary>
        <div class="flex flex-wrap gap-1 px-3 pb-3">
          <% existing_klass_students.sort_by { |klass_student| klass_student.student.name }.each do |klass_student| %>
            <span class="badge badge-ghost badge-sm">
              <%= klass_student.student.name %>
              <% if klass_student.student.identity_suffix.present? %>
                <span class="text-base-content/40"><%= klass_student.student.identity_suffix %></span>
              <% end %>
              <% if klass_student.status != "in" %>
                <span class="text-base-content/40"><%= klass_student.status == "out" ? "退" : "转" %></span>
              <% end %>
            </span>
          <% end %>
        </div>
      </details>
    <% end %>

    <%= render "admin/shared/student_multiselect",
          options: candidates.map { |student| { student: student, checked: false, badge: nil } },
          id_prefix: "klass_#{item.id || "new"}",
          grade_selector: "#klass_#{item.id || "new"}_semester_klass_grade_id",
          hint: "所选学员从入班课次开始加入，之前课次补记为缺课；默认第 1 课。",
          quick_add: true,
          empty_message: "没有匹配的学员。" %>
    </div>
  </div>

  <%= form.submit item.new_record? ? "开班" : "保存修改", class: "btn btn-primary w-full" %>
<% end %>
