<% content_for :page_title, @sk.name %>
<% content_for :page_subtitle, "#{@sk.semester.name} · #{@sk.grade.name} #{@sk.subject.name} · #{@sk.teacher.name} 老师" %>
<% content_for :breadcrumb do %>
  <%= link_to "班级管理", admin_semester_klasses_path, class: "hover:text-primary" %>
  <span>/</span>
  <span><%= @sk.name %></span>
<% end %>
<% content_for :page_actions do %>
  <%= render "admin/shared/drawer", item: @sk, drawer_id: "drawer-klass-show", button_name: "班级详情", drawer_width: "180", drawer_content: "admin/semester_klasses/form" %>
  <%= render "admin/shared/drawer", item: SemesterKlass.new, drawer_id: "drawer-klass-new", button_name: "开班", drawer_width: "180", drawer_content: "admin/semester_klasses/form" %>
  <%= link_to "复制历史班级", copy_admin_semester_klasses_path, class: "btn btn-sm btn-outline btn-primary" %>
<% end %>

<div class="mb-4 flex flex-wrap gap-2">
  <span class="badge badge-primary badge-sm gap-1">
    <span class="h-1.5 w-1.5 rounded-full bg-primary-content"></span>
    在班 <%= @sk.current_active_students.count %> 人
  </span>
  <span class="badge badge-ghost badge-sm">共 <%= @sk.courses.count %> 课次</span>
  <span class="badge badge-ghost badge-sm">已开 <%= @sk.courses.where.not(start_date: nil).count %> 课</span>
  <span class="badge badge-outline badge-secondary badge-sm"><%= SemesterKlass::GENRE_MAP_REVERSE[@sk.genre] %></span>
</div>

<div class="flex flex-col gap-4 lg:flex-row">
  <div class="wt-surface shrink-0 p-2 lg:w-56">
    <%= render "admin/semester_klasses/menu", grades: @grades %>
  </div>

  <div class="wt-surface min-w-0 flex-1 overflow-x-auto">
    <table class="table table-xs">
      <thead class="bg-base-200/60 text-xs uppercase tracking-wide text-base-content/60">
        <tr>
          <th class="sticky left-0 z-10 bg-base-200/60">学员</th>
          <% @sk.courses.each do |course| %>
            <th class="text-center whitespace-nowrap">第 <%= course.seq %> 课</th>
          <% end %>
          <th class="text-right">操作</th>
        </tr>
      </thead>
      <tbody>
        <% @sk.klass_students.each do |ks| %>
          <tr class="hover:bg-base-200/40">
            <th class="sticky left-0 z-10 whitespace-nowrap bg-base-100 font-medium"><%= ks.student.name %></th>
            <% @sk.courses.each do |course| %>
              <td class="text-center">
                <% if course.started? %>
                  <%= render "admin/semester_klasses/attendance_dropdown", semester_klass_student: ks, course: course, student: ks.student, attendance: course.attendances.find_by(klass_student: ks) %>
                <% else %>
                  <span class="text-xs text-base-content/30">未开课</span>
                <% end %>
              </td>
            <% end %>
            <td class="text-right">
              <%= button_to admin_semester_klass_klass_student_path(@sk, ks), method: :delete, data: { confirm: "确定删除？" }, class: "btn btn-xs btn-square btn-ghost text-error", title: "删除", aria: { label: "删除" } do %>
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
      <tfoot>
        <tr>
          <td class="sticky left-0 z-10 bg-base-100 text-xs text-base-content/50">课次操作</td>
          <% if @sk.students.exists? %>
            <% add_student_icon = '<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z" /></svg>'.html_safe %>
            <% @sk.courses.each do |course| %>
              <td class="text-center">
                <% if course.started? %>
                  <span class="badge badge-success badge-xs">已开课</span>
                <% else %>
                  <%= button_to start_admin_semester_klass_course_path(@sk, course), method: :put, class: "btn btn-xs btn-square btn-primary", title: "开课", aria: { label: "开课" } do %>
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" /><path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                  <% end %>
                <% end %>
                <div class="mt-1.5">
                  <%= render "admin/shared/drawer", item: course, drawer_id: "drawer-insert-student-#{@sk.id}-#{course.id}", button_name: "添加学员", button_icon: add_student_icon, drawer_width: "180", drawer_content: "admin/semester_klasses/insert_students_form" %>
                </div>
              </td>
            <% end %>
          <% end %>
          <td></td>
        </tr>
      </tfoot>
    </table>
    <% if @sk.klass_students.empty? %>
      <div class="p-10 text-center text-sm text-base-content/50">该班级暂无学员，可通过课次下方的「添加学员」导入</div>
    <% end %>
  </div>
</div>
