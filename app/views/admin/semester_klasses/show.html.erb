<% content_for :page_title, @sk.name %>
<% content_for :page_subtitle, "#{@sk.semester.name} · #{@sk.grade.name} #{@sk.subject.name} · #{@sk.teacher.name} 老师" %>
<% content_for :breadcrumb do %>
  <%= link_to "班级管理", admin_semester_klasses_path, class: "hover:text-primary" %>
  <span>/</span>
  <span><%= @sk.name %></span>
<% end %>
<% content_for :page_actions do %>
  <%= render "admin/shared/drawer", item: SemesterKlass.new, drawer_id: "drawer-klass-new", button_name: "开班", drawer_width: "240", drawer_content: "admin/semester_klasses/form" %>
  <%= render "admin/shared/drawer", item: @sk, drawer_id: "drawer-klass-show", button_name: "班级详情", drawer_width: "180", drawer_content: "admin/semester_klasses/form" %>
  <% if @next_semester %>
    <%= render "admin/shared/drawer", item: @sk, drawer_id: "drawer-copy", button_name: "复制",
          button_class: "btn btn-xs btn-outline btn-primary", drawer_width: "240",
          drawer_content: "admin/semester_klasses/copy_form",
          drawer_locals: { return_klass_id: @sk.id } %>
  <% else %>
    <span class="btn btn-xs btn-outline btn-primary btn-disabled" title="下学期尚未创建">复制</span>
  <% end %>
  <%= link_to export_attendance_admin_semester_klass_path(@sk), class: "btn btn-xs btn-outline btn-primary", data: { turbo: false } do %>
    <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3" /></svg>
    导出考勤
  <% end %>
  <% if @courses.any?(&:started?) %>
    <span class="btn btn-xs btn-outline btn-error btn-disabled" title="班级已有开课记录，不能删除">删除班级</span>
  <% else %>
    <%= button_to "删除班级", admin_semester_klass_path(@sk), method: :delete,
          class: "btn btn-xs btn-outline btn-error",
          data: { turbo_confirm: "确定删除班级「#{@sk.name}」吗？课次和学员报名记录会一并删除，且不可恢复。" } %>
  <% end %>
<% end %>

<%= turbo_frame_tag "klass_detail" do %>
<div id="flash"><%= render "admin/shared/alert" if turbo_frame_request? %></div>
<div class="mb-4 flex flex-wrap gap-2">
  <span class="badge badge-primary badge-sm gap-1">
    <span class="h-1.5 w-1.5 rounded-full bg-primary-content"></span>
    在班 <%= @active_student_count %> 人
  </span>
  <span class="badge badge-ghost badge-sm">共 <%= @courses.size %> 课次</span>
  <span class="badge badge-ghost badge-sm">已开 <%= @courses.count(&:started?) %> 课</span>
  <span class="badge badge-ghost badge-sm">已预留 <%= @reserved_student_ids.size %> 人</span>
  <span class="badge badge-outline <%= @sk.genre_badge_class %> badge-sm"><%= SemesterKlass::GENRE_MAP_REVERSE[@sk.genre] %></span>
</div>

<div data-controller="transfer-drawer attendance-select">
<div class="flex flex-col gap-4 lg:flex-row">
  <div class="wt-surface shrink-0 p-2 lg:sticky lg:top-20 lg:max-h-[calc(100vh-6rem)] lg:w-56 lg:self-start lg:overflow-y-auto">
    <p class="px-2 pb-1 pt-1 text-xs font-semibold uppercase tracking-wider text-base-content/40">班级切换</p>
    <%= render "admin/semester_klasses/menu", sks: @sks, current_sk: @sk %>
  </div>

  <div class="wt-surface min-w-0 flex-1 overflow-x-auto" data-controller="attendance-search">
    <div class="flex flex-wrap items-center justify-between gap-2 border-b border-base-200 px-3 py-2">
      <div class="flex shrink-0 items-center gap-2">
        <label class="input input-sm flex items-center gap-2 rounded-field">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" class="h-4 w-4 shrink-0 opacity-60"><path fill-rule="evenodd" d="M9.965 11.026a5 5 0 1 1 1.06-1.06l2.755 2.754a.75.75 0 1 1-1.06 1.06l-2.755-2.754ZM10.5 7a3.5 3.5 0 1 1-7 0 3.5 3.5 0 0 1 7 0Z" clip-rule="evenodd" /></svg>
          <input type="search" class="w-32 grow sm:w-40" placeholder="搜索学员姓名" autocomplete="off"
                 aria-label="搜索学员姓名"
                 data-attendance-search-target="input"
                 data-action="input->attendance-search#apply keydown.esc->attendance-search#clear">
        </label>
        <span class="text-xs text-base-content/50" data-attendance-search-target="count"></span>
        <% if @klass_students.any? %>
          <span class="text-xs text-base-content/50" data-attendance-select-target="count"></span>
          <% if @next_semester && @reserve_candidates.any? %>
            <button type="button" class="btn btn-sm btn-outline btn-primary whitespace-nowrap"
                    data-attendance-select-target="reserveButton" data-action="attendance-select#openReserve" disabled>预留</button>
          <% end %>
          <button type="button" class="btn btn-sm btn-outline btn-error whitespace-nowrap"
                  data-attendance-select-target="removeButton" data-action="attendance-select#openRemove" disabled>移出</button>
        <% end %>
        <% if @next_course %>
          <%= button_to "开第 #{@next_course.seq} 课", start_admin_semester_klass_course_path(@sk, @next_course), method: :put,
                data: { turbo_frame: "_top" },
                class: "btn btn-sm btn-primary whitespace-nowrap" %>
          <% unstarted_courses = @courses.reject(&:started?) %>
          <% if unstarted_courses.size > 1 %>
            <%= form_with url: start_through_admin_semester_klass_courses_path(@sk), method: :put,
                  data: { turbo_frame: "_top" },
                  class: "flex items-center gap-1" do |form| %>
              <label for="through_seq" class="whitespace-nowrap text-xs text-base-content/60">开课到</label>
              <%= select_tag :through_seq,
                    options_for_select(unstarted_courses.map { |course| [ "第 #{course.seq} 课", course.seq ] }, unstarted_courses.first.seq),
                    id: "through_seq", class: "select select-sm w-28" %>
              <%= form.submit "批量开课", class: "btn btn-sm btn-outline btn-primary whitespace-nowrap" %>
            <% end %>
          <% end %>
        <% else %>
          <span class="badge badge-success badge-sm">全部课次已开课</span>
        <% end %>
      </div>
      <div class="flex flex-wrap items-center gap-x-2.5 gap-y-1 text-[11px] text-base-content/60">
        <span class="font-medium text-base-content/70">图例</span>
        <% Attendance::STATUS_META.each do |status, meta| %>
          <span class="inline-flex items-center gap-1">
            <span class="badge badge-soft badge-<%= meta[:color] %> badge-xs"><%= meta[:label] %></span>
            <span><%= meta[:name] %></span>
          </span>
        <% end %>
      </div>
    </div>
    <table class="table table-xs">
      <thead class="bg-base-200/60 text-xs uppercase tracking-wide text-base-content/60">
        <tr>
          <th class="text-center">
            <input type="checkbox" class="checkbox checkbox-xs" aria-label="全选学员"
                   data-attendance-select-target="selectAll" data-action="change->attendance-select#toggleAll">
          </th>
          <th class="sticky left-0 z-10 bg-base-200/60">学员</th>
          <% @courses.each do |course| %>
            <th class="whitespace-nowrap text-center">
              <span class="block">第 <%= course.seq %> 课</span>
              <span class="mt-0.5 block text-[10px] font-normal normal-case tracking-normal text-base-content/40">
                <%= course.started? ? course.start_date.strftime("%m-%d") : "未开课" %>
              </span>
            </th>
          <% end %>
        </tr>
      </thead>
      <tbody>
        <% @klass_students.each do |ks| %>
          <%= render "admin/semester_klasses/attendance_row", ks: ks %>
        <% end %>
        <tr class="hidden" data-attendance-search-target="empty">
          <td colspan="<%= @courses.size + 2 %>" class="py-8 text-center text-sm text-base-content/50">没有匹配的学员</td>
        </tr>
      </tbody>
    </table>
    <% if @klass_students.empty? %>
      <div class="p-10 text-center text-sm text-base-content/50">该班级暂无学员，可在「班级详情」中添加</div>
    <% end %>
  </div>
</div>

<% if @transfer_target_klasses.any? %>
  <%= render "admin/semester_klasses/transfer_drawer", target_klasses: @transfer_target_klasses, target_counts: @transfer_target_counts %>
<% end %>
<%= render "admin/semester_klasses/reserve_modal" %>
<%= render "admin/semester_klasses/remove_modal" %>
</div>

<% if @left_klass_students.any? %>
  <div class="wt-surface mt-4 p-4">
    <details>
      <summary class="cursor-pointer text-sm font-semibold">
        转出 / 退课学员 <%= @left_klass_students.size %> 人
      </summary>
      <ul class="mt-3 divide-y divide-base-200">
        <% @left_klass_students.each do |klass_student| %>
          <% leave = @leave_attendance_by_klass_student[klass_student.id] %>
          <% transfer = klass_student.transfer? %>
          <% target_klass = @transfer_target_by_klass_student[klass_student.id]&.transfer_target_klass %>
          <li class="flex flex-wrap items-center justify-between gap-2 py-2">
            <div class="min-w-0">
              <span class="text-sm font-medium"><%= klass_student.student.identity_label %></span>
              <span class="badge badge-soft badge-neutral badge-xs ml-1">
                <%= transfer ? "转出" : "退课" %>
              </span>
              <% if leave %>
                <span class="ml-2 text-xs text-base-content/40">第 <%= leave.course.seq %> 课起</span>
              <% end %>
              <% if transfer %>
                <p class="mt-0.5 text-xs text-base-content/40">
                  <% if target_klass %>
                    已转入 <%= target_klass.name %>，如需回班请在该班考勤格中转出到本班
                  <% else %>
                    如需回班，请到转入的班级中转出到本班
                  <% end %>
                </p>
              <% end %>
            </div>
            <% unless transfer %>
              <%= button_to "撤销", reinstate_admin_semester_klass_klass_student_path(@sk, klass_student),
                    method: :put, class: "btn btn-xs btn-ghost text-primary",
                    data: { turbo_confirm: "确定撤销该学员的退课记录，恢复为在班吗？" } %>
            <% end %>
          </li>
        <% end %>
      </ul>
    </details>
  </div>
<% end %>

<% if @archived_klass_students.any? %>
  <div class="wt-surface mt-4 p-4">
    <details>
      <summary class="cursor-pointer text-sm font-semibold">已移出学员 <%= @archived_klass_students.size %> 人（历史考勤保留）</summary>
      <ul class="mt-3 divide-y divide-base-200">
        <% @archived_klass_students.each do |klass_student| %>
          <li class="flex flex-wrap items-center justify-between gap-2 py-2">
            <div class="min-w-0">
              <span class="text-sm font-medium"><%= klass_student.student.identity_label %></span>
              <span class="ml-2 text-xs text-base-content/40">移出于 <%= klass_student.archived_at.strftime("%Y-%m-%d %H:%M") %></span>
            </div>
            <%= button_to "恢复", restore_admin_semester_klass_klass_student_path(@sk, klass_student),
                  method: :put, class: "btn btn-xs btn-ghost text-primary" %>
          </li>
        <% end %>
      </ul>
    </details>
  </div>
<% end %>
<% end %>
