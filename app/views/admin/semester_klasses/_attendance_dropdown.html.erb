<div class="relative inline-block" data-controller="floating-card">
  <div tabindex="0" role="button" data-floating-card-target="trigger"
       data-action="click->floating-card#toggle keydown->floating-card#handleTriggerKey"
       class="badge badge-soft badge-<%= attendance&.badge_class || "ghost" %> badge-sm min-w-6 cursor-pointer justify-center font-semibold"
       title="<%= attendance&.status_name || "未录入" %>"
       aria-label="考勤状态：<%= attendance&.status_name || "未录入" %>">
    <%= attendance&.status_label || "—" %>
  </div>

  <div data-floating-card-target="card"
       class="card fixed z-50 hidden w-64 flex-col gap-2.5 rounded-box border border-base-300/70 bg-base-100 p-3 shadow-xl">
    <div class="flex items-start justify-between gap-2">
      <div class="min-w-0">
        <p class="truncate text-xs font-semibold"><%= student.name %><% if student.identity_suffix.present? %> <span class="font-normal text-base-content/40"><%= student.identity_suffix %></span><% end %></p>
        <p class="mt-0.5 text-[11px] text-base-content/50">第 <%= course.seq %> 课考勤</p>
        <% if attendance&.marked_by %>
          <p class="mt-0.5 text-[11px] text-base-content/40">操作人：<%= attendance.marked_by.name %></p>
        <% end %>
      </div>
      <span class="badge badge-soft badge-<%= attendance&.badge_class || "ghost" %> badge-xs shrink-0">
        <%= attendance&.status_name || "未录入" %>
      </span>
    </div>

    <% if attendance.present? %>
      <% if attendance.transfer? %>
        <% if attendance.manual_transfer_out? %>
          <p class="text-[11px] leading-snug text-base-content/50">
            已标记为转出：本课次学员未在本班就读，不计入出勤。
          </p>
          <%= button_to "恢复正常",
                mark_admin_semester_klass_course_attendance_path(@sk, course, attendance.id, status: "normal"),
                method: :put, class: "btn btn-xs w-full btn-ghost" %>
        <% elsif semester_klass_student.transfer? %>
          <p class="text-[11px] leading-snug text-base-content/50">
            已转出，不可撤销；如需回班，请在转入的班级中把学员转出到本班。
          </p>
        <% end %>
      <% elsif attendance.transfer_in? %>
        <% if attendance.manual_transfer_in? %>
          <p class="text-[11px] leading-snug text-base-content/50">
            已标记为转入：本课次学员尚未在本班就读，不计入出勤。
          </p>
          <%= button_to "恢复正常",
                mark_admin_semester_klass_course_attendance_path(@sk, course, attendance.id, status: "normal"),
                method: :put, class: "btn btn-xs w-full btn-ghost" %>
        <% else %>
          <p class="text-[11px] leading-snug text-base-content/50">
            由 <%= semester_klass_student.transfer_source_klass&.name || "其他班级" %> 转入<% if semester_klass_student.transfer_in_seq %>，第 <%= semester_klass_student.transfer_in_seq %> 课起在本班上课<% end %>；本课次在转入前，学员未在本班就读。
          </p>
        <% end %>
      <% else %>
        <%
        action_groups =
          case attendance.status
          when "normal"
            [
              [
                [ "缺课", "absent", "btn-error" ],
                [ "事假", "personal_leave", "btn-info" ],
                [ "病假", "sick_leave", "btn-warning" ]
              ],
              [
                [ "退课", "quit", "btn-ghost" ],
                [ "转出", "transfer", "btn-ghost" ]
              ]
            ]
          when "filled"
            [
              [ [ "恢复正常", "normal", "btn-ghost" ] ],
              [
                [ "缺课", "absent", "btn-error" ],
                [ "事假", "personal_leave", "btn-info" ],
                [ "病假", "sick_leave", "btn-warning" ]
              ],
              [
                [ "退课", "quit", "btn-ghost" ],
                [ "转出", "transfer", "btn-ghost" ]
              ]
            ]
          when "absent"
            [
              [ [ "恢复正常", "normal", "btn-ghost" ] ],
              [
                [ "事假", "personal_leave", "btn-info" ],
                [ "病假", "sick_leave", "btn-warning" ],
                [ "补课销假", "filled", "btn-success" ]
              ],
              [
                [ "退课", "quit", "btn-ghost" ],
                [ "转出", "transfer", "btn-ghost" ]
              ]
            ]
          when "personal_leave", "sick_leave"
            [
              [ [ "恢复正常", "normal", "btn-ghost" ] ],
              [ [ "补课销假", "filled", "btn-success" ] ],
              [
                [ "退课", "quit", "btn-ghost" ],
                [ "转出", "transfer", "btn-ghost" ]
              ]
            ]
          else
            [ [ [ "重新加入", "rejoin", "btn-primary" ] ] ]
          end
        # 标记为转入 / 转出只用于结课后修正考勤表（只改本格），退课行只能重新加入
        if @klass_ended && !attendance.quit?
          action_groups << [
            [ "标记为转入", "transfer_in", "btn-ghost" ],
            [ "标记为转出", "transfer_out", "btn-ghost" ]
          ]
        end
      %>

      <% action_groups.each_with_index do |actions, group_index| %>
        <% grid_cols = { 1 => "grid-cols-1", 2 => "grid-cols-2", 3 => "grid-cols-3" }.fetch(actions.size, "grid-cols-2") %>
        <div class="<%= "mt-0.5 border-t border-base-300 pt-2.5" if group_index.positive? %>">
          <div class="grid <%= grid_cols %> gap-1.5">
            <% actions.each do |(label, status, color)| %>
              <% if status == "transfer" %>
                <% if @transfer_target_klasses.present? %>
                  <button type="button"
                          class="btn btn-xs w-full <%= color %>"
                          data-action="transfer-drawer#open"
                          data-transfer-url="<%= transfer_admin_semester_klass_course_attendance_path(@sk, course, attendance.id) %>"
                          data-transfer-student="<%= student.identity_label %>"
                          data-transfer-source="<%= @sk.name %>"
                          data-transfer-course="第 <%= course.seq %> 课"
                          data-transfer-class-ids="<%= @enrolled_target_ids_by_student[student.id]&.join(",") %>"
                          data-transfer-subject-id="<%= @sk.subject_id %>">
                    <%= label %>
                  </button>
                <% else %>
                  <button type="button" class="btn btn-xs w-full <%= color %>" disabled
                          title="暂无可转入的班级，仅离开班级请使用「退课」">
                    <%= label %>
                  </button>
                <% end %>
              <% else %>
                <%= button_to label,
                      mark_admin_semester_klass_course_attendance_path(@sk, course, attendance.id, status:),
                      method: :put,
                      class: "btn btn-xs w-full #{color}" %>
              <% end %>
            <% end %>
          </div>
        </div>
      <% end %>
      <% end %>
    <% else %>
      <p class="text-xs text-error">考勤记录异常，请联系管理员</p>
    <% end %>
  </div>
</div>
