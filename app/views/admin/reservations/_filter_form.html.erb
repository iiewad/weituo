<%= search_form_for @q, url: admin_reservations_path, class: "flex flex-wrap items-center gap-2" do |f| %>
  <label class="input input-sm flex items-center gap-2 rounded-field">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" class="h-4 w-4 shrink-0 opacity-60"><path fill-rule="evenodd" d="M9.965 11.026a5 5 0 1 1 1.06-1.06l2.755 2.754a.75.75 0 1 1-1.06 1.06l-2.755-2.754ZM10.5 7a3.5 3.5 0 1 1-7 0 3.5 3.5 0 0 1 7 0Z" clip-rule="evenodd" /></svg>
    <%= f.search_field :student_name_cont, placeholder: "学员姓名", class: "grow" %>
  </label>
  <%= f.select :source_semester_id_eq, @semesters.map { |semester| [semester.name, semester.id] }, { prompt: "全部源学期" }, class: "select select-sm rounded-field", aria: { label: "源学期" } %>
  <%= f.select :semester_id_eq, @semesters.map { |semester| [semester.name, semester.id] }, { prompt: "全部预留目标学期" }, class: "select select-sm rounded-field", aria: { label: "预留目标学期" } %>
  <%= f.select :grade_id_eq, @grades.map { |grade| [grade.name, grade.id] }, { prompt: "全部年级" }, class: "select select-sm rounded-field", aria: { label: "目标年级" } %>
  <%= f.select :subject_id_eq, @subjects.map { |subject| [subject.name, subject.id] }, { prompt: "全部科目" }, class: "select select-sm rounded-field", aria: { label: "科目" } %>
  <%= f.select :genre_eq, SemesterKlass::GENRE_MAP.map { |name, code| [name, code] }, { prompt: "全部班型" }, class: "select select-sm rounded-field", aria: { label: "班型" } %>
  <%= f.collection_select :teacher_id_eq, @teachers, :id, ->(teacher) { "#{teacher.name}（#{teacher.subject.name}）" },
        { prompt: "全部教师" }, class: "select select-sm rounded-field", aria: { label: "教师" } %>
  <%= select_tag :status,
        options_for_select([ [ "待分班", "pending" ], [ "已生成", "generated" ], [ "全部", "all" ] ], @status),
        id: "reservation_status", class: "select select-sm rounded-field", aria: { label: "预留状态" } %>
  <%= f.submit "查找", class: "btn btn-sm btn-primary" %>
  <% if params[:q].present? || params[:status].present? %>
    <%= link_to "重置", admin_reservations_path, class: "btn btn-sm btn-ghost" %>
  <% end %>
<% end %>
