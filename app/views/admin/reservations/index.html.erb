<% content_for :page_title, "预留表" %>
<% content_for :page_subtitle, "共 #{@reservations.total_count} 条预留 · 待分班 #{@pending_count} 人 · #{Current.campuse&.name}" %>
<% index_params = { q: params[:q]&.to_unsafe_h, status: params[:status] }.compact %>

<div class="mb-4">
  <%= render "filter_form" %>
</div>

<div class="wt-surface overflow-x-auto">
  <table class="table table-sm">
    <thead class="bg-base-200/60 text-xs uppercase tracking-wide text-base-content/60">
      <tr>
        <th>学员</th>
        <th>源学期</th>
        <th>预留目标学期</th>
        <th>目标年级</th>
        <th>科目</th>
        <th>班型</th>
        <th>教师</th>
        <th>状态</th>
        <th class="text-right">操作</th>
      </tr>
    </thead>
    <tbody>
      <% @reservations.each do |reservation| %>
        <tr class="hover:bg-base-200/40">
          <td>
            <div class="font-medium"><%= reservation.student.identity_label %></div>
            <div class="text-xs text-base-content/50"><%= reservation.student.identity_detail %></div>
          </td>
          <td class="text-base-content/70"><%= reservation.source_semester&.name || "—" %></td>
          <td class="text-base-content/70"><%= reservation.semester.name %></td>
          <td><span class="badge badge-outline badge-primary badge-sm"><%= reservation.grade.name %></span></td>
          <td class="font-medium"><%= reservation.subject.name %></td>
          <td>
            <span class="badge badge-outline <%= SemesterKlass::GENRE_BADGE.fetch(reservation.genre, "badge-ghost") %> badge-sm">
              <%= SemesterKlass::GENRE_MAP_REVERSE[reservation.genre] %>
            </span>
            <span class="ml-1 text-xs text-base-content/50"><%= SemesterKlass::PHASE_PREFIX[reservation.phase] %></span>
          </td>
          <td class="text-base-content/70"><%= reservation.teacher&.name || "待定" %></td>
          <td>
            <% if reservation.generated? %>
              <span class="badge badge-soft badge-success badge-sm">已生成 · <%= reservation.semester_klass.name %></span>
            <% else %>
              <span class="badge badge-soft badge-warning badge-sm">待分班</span>
            <% end %>
          </td>
          <td class="text-right">
            <% unless reservation.generated? %>
              <%= render "generate_action", reservation: reservation, index_params: index_params %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <% if @reservations.empty? %>
    <div class="p-10 text-center text-sm text-base-content/50">没有符合条件的预留记录，可在班级详情页的「预留」中登记。</div>
  <% end %>
</div>

<% if @reservations.total_pages > 1 %>
  <div class="mt-4 flex items-center justify-center gap-2">
    <%= link_to_previous_page @reservations, "«", class: "btn btn-sm btn-ghost" %>
    <span class="btn btn-sm btn-ghost no-animation"><%= @reservations.current_page %> / <%= @reservations.total_pages %></span>
    <%= link_to_next_page @reservations, "»", class: "btn btn-sm btn-ghost" %>
  </div>
<% end %>
