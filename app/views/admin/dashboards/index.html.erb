<% content_for :page_title, "首页概览" %>
<% grade_label = @grades.any? ? "授权年级 #{@grades.map(&:name).join(" / ")}" : "暂无授权年级" %>
<% content_for :page_subtitle, [ @semester&.name, @campuse&.name, grade_label ].compact.join(" · ") %>
<% content_for :page_actions do %>
  <%= link_to "使用指引", root_path(guide: 1), class: "btn btn-xs btn-outline btn-primary" %>
<% end %>

<div class="mb-5 grid gap-3 sm:grid-cols-2 xl:grid-cols-4">
  <div class="wt-surface p-4">
    <p class="text-xs text-base-content/50">学员总数</p>
    <p class="mt-1 text-2xl font-semibold"><%= @student_count %><span class="ml-1 text-sm font-normal text-base-content/50">人</span></p>
    <p class="mt-1 text-xs text-base-content/40">本月新增 <%= @new_students_this_month %> 人</p>
    <p class="mt-2 h-1 w-full rounded-full bg-primary/20"><span class="block h-1 w-full rounded-full bg-primary"></span></p>
  </div>

  <div class="wt-surface p-4">
    <p class="text-xs text-base-content/50">在班学员</p>
    <p class="mt-1 text-2xl font-semibold"><%= @active_student_count %><span class="ml-1 text-sm font-normal text-base-content/50">人</span></p>
    <p class="mt-1 text-xs text-base-content/40">未入班 <%= @not_in_class_count %> 人</p>
    <p class="mt-2 h-1 w-full rounded-full bg-success/20"><span class="block h-1 w-3/4 rounded-full bg-success"></span></p>
  </div>

  <div class="wt-surface p-4">
    <p class="text-xs text-base-content/50">本学期班级</p>
    <p class="mt-1 text-2xl font-semibold"><%= @klass_count %><span class="ml-1 text-sm font-normal text-base-content/50">个</span></p>
    <p class="mt-1 text-xs text-base-content/40">共 <%= @total_courses %> 课次</p>
    <p class="mt-2 h-1 w-full rounded-full bg-secondary/20"><span class="block h-1 w-2/3 rounded-full bg-secondary"></span></p>
  </div>

  <div class="wt-surface p-4">
    <p class="text-xs text-base-content/50">教师</p>
    <p class="mt-1 text-2xl font-semibold"><%= @teacher_count %><span class="ml-1 text-sm font-normal text-base-content/50">人</span></p>
    <p class="mt-1 text-xs text-base-content/40">当前校区</p>
    <p class="mt-2 h-1 w-full rounded-full bg-accent/20"><span class="block h-1 w-1/2 rounded-full bg-accent"></span></p>
  </div>
</div>

<div class="mb-5 grid gap-3 lg:grid-cols-3">
  <div class="wt-surface p-4 lg:col-span-2">
    <div class="flex flex-wrap items-center justify-between gap-2">
      <h2 class="text-sm font-semibold">本学期课次进度</h2>
      <span class="text-xs text-base-content/50"><%= @progress %>%</span>
    </div>
    <p class="mt-2 text-2xl font-semibold">
      <%= @started_courses %><span class="ml-1 text-sm font-normal text-base-content/50">/ <%= @total_courses %> 课次已开</span>
    </p>
    <div class="mt-2 h-2 w-full rounded-full bg-base-200">
      <span class="block h-2 rounded-full bg-primary" style="width: <%= @progress %>%"></span>
    </div>

    <div class="mt-4 grid grid-cols-2 gap-2 sm:grid-cols-4">
      <div class="rounded-box bg-base-200/60 p-2.5">
        <p class="text-[11px] text-base-content/50">今日课次</p>
        <p class="mt-0.5 text-lg font-semibold"><%= @today_courses.size %></p>
      </div>
      <div class="rounded-box bg-base-200/60 p-2.5">
        <p class="text-[11px] text-base-content/50">待开课次</p>
        <p class="mt-0.5 text-lg font-semibold"><%= @total_courses - @started_courses %></p>
      </div>
      <div class="rounded-box bg-base-200/60 p-2.5">
        <p class="text-[11px] text-base-content/50">待入班</p>
        <p class="mt-0.5 text-lg font-semibold"><%= @not_in_class_count %></p>
      </div>
      <div class="rounded-box bg-base-200/60 p-2.5">
        <p class="text-[11px] text-base-content/50">本月新增</p>
        <p class="mt-0.5 text-lg font-semibold"><%= @new_students_this_month %></p>
      </div>
    </div>
  </div>

  <div class="wt-surface p-4">
    <h2 class="text-sm font-semibold">快捷操作</h2>
    <div class="mt-3 grid grid-cols-2 gap-2">
      <%= link_to admin_semester_klasses_path, class: "rounded-box border border-base-300 px-3 py-2.5 text-xs transition hover:border-primary/40 hover:bg-base-200/50" do %>
        <span class="block font-medium">班级管理</span>
        <span class="mt-0.5 block text-[11px] text-base-content/40">开班 · 考勤</span>
      <% end %>
      <%= link_to admin_students_path, class: "rounded-box border border-base-300 px-3 py-2.5 text-xs transition hover:border-primary/40 hover:bg-base-200/50" do %>
        <span class="block font-medium">学员管理</span>
        <span class="mt-0.5 block text-[11px] text-base-content/40">档案 · 入班</span>
      <% end %>
      <%= link_to statement_admin_semester_klasses_path, class: "rounded-box border border-base-300 px-3 py-2.5 text-xs transition hover:border-primary/40 hover:bg-base-200/50" do %>
        <span class="block font-medium">班级报表</span>
        <span class="mt-0.5 block text-[11px] text-base-content/40">经营数据</span>
      <% end %>
      <%= link_to copy_admin_semester_klasses_path, class: "rounded-box border border-base-300 px-3 py-2.5 text-xs transition hover:border-primary/40 hover:bg-base-200/50" do %>
        <span class="block font-medium">复制班级</span>
        <span class="mt-0.5 block text-[11px] text-base-content/40">带到新学期</span>
      <% end %>
      <%= link_to admin_teachers_path, class: "rounded-box border border-base-300 px-3 py-2.5 text-xs transition hover:border-primary/40 hover:bg-base-200/50" do %>
        <span class="block font-medium">教师管理</span>
        <span class="mt-0.5 block text-[11px] text-base-content/40">师资安排</span>
      <% end %>
      <%= link_to admin_guide_path, class: "rounded-box border border-base-300 px-3 py-2.5 text-xs transition hover:border-primary/40 hover:bg-base-200/50" do %>
        <span class="block font-medium">操作指南</span>
        <span class="mt-0.5 block text-[11px] text-base-content/40">使用帮助</span>
      <% end %>
      <%= link_to root_path(guide: 1), class: "rounded-box border border-base-300 px-3 py-2.5 text-xs transition hover:border-primary/40 hover:bg-base-200/50" do %>
        <span class="block font-medium">使用指引</span>
        <span class="mt-0.5 block text-[11px] text-base-content/40">分步上手</span>
      <% end %>
    </div>
  </div>
</div>

<div class="grid gap-4 lg:grid-cols-2">
  <div class="wt-surface p-4">
    <div class="flex items-center justify-between gap-2">
      <h2 class="text-sm font-semibold">最近班级</h2>
      <%= link_to "全部", admin_semester_klasses_path, class: "text-xs text-primary hover:underline" %>
    </div>

    <% if @recent_klasses.any? %>
      <ul class="mt-2 divide-y divide-base-200">
        <% @recent_klasses.each do |semester_klass| %>
          <li>
            <%= link_to admin_semester_klass_path(semester_klass), class: "flex items-center justify-between gap-3 py-2.5 text-sm transition hover:text-primary" do %>
              <span class="min-w-0">
                <span class="font-medium"><%= semester_klass.name %></span>
                <span class="ml-1 text-xs text-base-content/50">
                  <%= semester_klass.grade.name %> · <%= semester_klass.subject.name %> · <%= semester_klass.teacher.name %>
                </span>
              </span>
              <span class="shrink-0 text-xs text-base-content/40">
                在班 <%= @recent_active_counts.fetch(semester_klass.id, 0) %>
              </span>
            <% end %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="mt-4 text-xs text-base-content/40">当前学期还没有班级，去「班级管理」开班或复制历史班级。</p>
    <% end %>
  </div>

  <div class="wt-surface p-4">
    <div class="flex items-center justify-between gap-2">
      <h2 class="text-sm font-semibold">最近学员</h2>
      <%= link_to "全部", admin_students_path, class: "text-xs text-primary hover:underline" %>
    </div>

    <% if @recent_students.any? %>
      <ul class="mt-2 divide-y divide-base-200">
        <% @recent_students.each do |student| %>
          <li class="flex items-center gap-2.5 py-2.5">
            <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-primary/10 text-xs font-semibold text-primary"><%= student.name.to_s.first %></span>
            <div class="min-w-0">
              <p class="truncate text-sm font-medium"><%= student.name %></p>
              <p class="text-xs text-base-content/50">
                <%= [ student.grade&.name || "未设置年级", student.day_school&.name || "未设置日校", student.identity_suffix ].compact.join(" · ") %>
              </p>
            </div>
            <span class="ml-auto shrink-0 text-xs text-base-content/40">
              <%= student.in_date&.strftime("%m-%d") || "—" %>
            </span>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="mt-4 text-xs text-base-content/40">当前校区还没有可展示的学员。</p>
    <% end %>
  </div>
</div>

<%= render "admin/shared/guide_wizard" if @guide_steps.any? %>
