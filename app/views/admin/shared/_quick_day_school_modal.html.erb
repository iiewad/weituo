<dialog id="quick-day-school-modal" class="modal"
        data-controller="quick-day-school"
        data-quick-day-school-create-url-value="<%= admin_day_schools_path %>"
        data-quick-day-school-csrf-value="<%= form_authenticity_token %>">
  <div class="modal-box">
    <h3 class="text-base font-semibold">快速添加日校</h3>
    <p class="mt-1 text-xs text-base-content/50">新增后会自动选中到当前学员的「日校」。</p>

    <div class="mt-4 space-y-3">
      <div>
        <label for="quick_day_school_name" class="mb-1 block text-xs font-medium text-base-content/60">日校名称</label>
        <input id="quick_day_school_name" type="text" autocomplete="off" required
               data-quick-day-school-target="name" class="input input-sm w-full" />
      </div>

      <p class="hidden text-xs text-error" data-quick-day-school-target="error"></p>

      <div class="flex justify-end gap-2">
        <button type="button" class="btn btn-ghost btn-sm" data-action="quick-day-school#close">取消</button>
        <button type="button" class="btn btn-primary btn-sm" data-action="quick-day-school#submit">保存并填入</button>
      </div>
    </div>
  </div>
  <form method="dialog" class="modal-backdrop"><button>close</button></form>
</dialog>
