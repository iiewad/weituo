<dialog id="quick-student-modal" class="modal"
        data-controller="quick-student"
        data-quick-student-create-url-value="<%= quick_create_admin_students_path %>"
        data-quick-student-csrf-value="<%= form_authenticity_token %>">
  <div class="modal-box">
    <h3 class="text-base font-semibold">快速添加学员</h3>
    <p class="mt-1 text-xs text-base-content/50">只需填写姓名和年级，创建后会直接出现在可选列表中。</p>

    <form class="mt-4 space-y-3" data-quick-student-target="form" data-action="submit->quick-student#submit">
      <input type="hidden" name="target_prefix" data-quick-student-target="prefix" />

      <div>
        <label for="quick_student_name" class="mb-1 block text-xs font-medium text-base-content/60">姓名</label>
        <input id="quick_student_name" name="student[name]" required autocomplete="off"
               data-quick-student-target="name" class="input input-sm w-full" />
      </div>

      <div>
        <label for="quick_student_grade" class="mb-1 block text-xs font-medium text-base-content/60">年级</label>
        <select id="quick_student_grade" name="student[grade_id]" required
                data-quick-student-target="grade" class="select select-sm w-full">
          <option value="">选择年级</option>
          <% Current.user.grades_by_campuse(Current.campuse.id).order(:level).each do |grade| %>
            <option value="<%= grade.id %>"><%= grade.name %></option>
          <% end %>
        </select>
      </div>

      <p class="hidden text-xs text-error" data-quick-student-target="error"></p>

      <div class="flex justify-end gap-2">
        <button type="button" class="btn btn-ghost btn-sm" data-action="quick-student#close">取消</button>
        <button type="submit" class="btn btn-primary btn-sm">保存并加入</button>
      </div>
    </form>
  </div>
  <form method="dialog" class="modal-backdrop"><button>close</button></form>
</dialog>
