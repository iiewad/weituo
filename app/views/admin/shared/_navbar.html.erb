<% campuse = Thread.current[:campuse] %>
<% semester = Thread.current[:semester] %>
<div class="sticky top-0 z-30 border-b border-base-300/70 bg-base-100/90 backdrop-blur">
  <div class="flex h-16 items-center gap-2 px-3 lg:px-6">
    <% if authenticated? %>
      <label for="wt-drawer" class="btn btn-ghost btn-sm btn-square lg:hidden" aria-label="打开菜单">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" /></svg>
      </label>
    <% end %>

    <%= link_to root_path, class: "flex shrink-0 items-center gap-2.5" do %>
      <div class="wt-brand-gradient flex h-9 w-9 items-center justify-center rounded-xl text-sm font-bold text-white shadow-sm">维</div>
      <div class="leading-tight">
        <span class="block text-sm font-semibold">维拓校务管理平台</span>
        <span class="block text-[11px] text-base-content/50">新梦想教育</span>
      </div>
    <% end %>

    <div class="flex-1"></div>

    <% if authenticated? %>
      <div class="hidden items-center gap-2 lg:flex">
        <div class="flex items-center gap-2 rounded-full border border-base-300/70 bg-base-200/60 px-3 py-1.5 text-xs">
          <span class="h-2 w-2 rounded-full bg-secondary"></span>
          <span class="text-base-content/50">校区</span>
          <span class="font-semibold"><%= campuse&.name || "未选择" %></span>
        </div>
        <div class="flex items-center gap-2 rounded-full border border-base-300/70 bg-base-200/60 px-3 py-1.5 text-xs">
          <span class="h-2 w-2 rounded-full bg-primary"></span>
          <span class="text-base-content/50">学期</span>
          <span class="font-semibold"><%= semester&.name || "未设置" %></span>
        </div>
      </div>

      <div class="dropdown dropdown-end ml-1">
        <div tabindex="0" role="button" class="btn btn-ghost btn-sm gap-2">
          <span class="flex h-7 w-7 items-center justify-center rounded-full bg-primary/10 text-xs font-semibold text-primary"><%= Current.user.name.to_s.first %></span>
          <span class="hidden sm:inline"><%= Current.user.name %></span>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 opacity-60" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
        </div>
        <ul tabindex="0" class="menu dropdown-content z-50 mt-2 w-56 rounded-box border border-base-300/70 bg-base-100 p-2 shadow-lg">
          <li class="menu-title">切换校区</li>
          <% Current.user.campuses.each do |c| %>
            <li>
              <%= link_to c.name, switch_thread_campuse_admin_school_campuse_path(school_id: campuse&.school_id || c.school_id, id: c.id), data: { turbo_prefetch: false }, class: ("active" if c == campuse) %>
            </li>
          <% end %>
          <% if campuse %>
            <li class="menu-title">切换学期</li>
            <% campuse.school.semesters.order(:seq).each do |s| %>
              <li>
                <%= link_to s.name, switch_thread_semester_admin_school_semester_path(school_id: campuse.school_id, id: s.id), data: { turbo_prefetch: false }, class: ("active" if s == semester) %>
              </li>
            <% end %>
          <% end %>
          <li class="my-1 border-t border-base-300/70 pt-1">
            <%= button_to "注销登录", session_path, method: :delete, class: "text-error" %>
          </li>
        </ul>
      </div>
    <% end %>
  </div>
</div>
