<dialog id="guide-wizard" class="modal" data-controller="guide-wizard"
        data-guide-wizard-auto-open-value="<%= @show_guide %>"
        data-guide-wizard-complete-url-value="<%= admin_complete_guide_path %>"
        data-guide-wizard-csrf-value="<%= form_authenticity_token %>">
  <div class="modal-box max-w-2xl">
    <div class="flex items-start justify-between gap-3">
      <div>
        <p class="text-[11px] font-medium tracking-wide text-primary">新手使用指引</p>
        <h3 class="mt-1 text-lg font-semibold">从配置到报表，一步步上手</h3>
        <p class="mt-1 text-xs text-base-content/50">步骤进度按当前数据自动判断，之后可从首页「使用指引」重新打开。</p>
      </div>
      <form method="dialog">
        <button class="btn btn-sm btn-circle btn-ghost" aria-label="关闭">✕</button>
      </form>
    </div>

    <div class="mt-4 space-y-3">
      <% @guide_steps.each_with_index do |step, index| %>
        <section data-guide-wizard-target="step"
                 class="<%= "hidden" if index.positive? %> rounded-box border border-base-200 bg-base-100 p-4">
          <div class="flex items-start justify-between gap-3">
            <div class="flex min-w-0 items-start gap-3">
              <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-primary/10 text-xs font-semibold text-primary"><%= index + 1 %></span>
              <div class="min-w-0">
                <p class="text-sm font-semibold"><%= step[:title] %></p>
                <p class="mt-1 text-xs leading-relaxed text-base-content/60"><%= step[:description] %></p>
              </div>
            </div>
            <% if step[:done].nil? %>
              <span class="badge badge-ghost badge-sm shrink-0">参考</span>
            <% elsif step[:done] %>
              <span class="badge badge-soft badge-success badge-sm shrink-0">已完成</span>
            <% else %>
              <span class="badge badge-soft badge-warning badge-sm shrink-0">待完成</span>
            <% end %>
          </div>

          <% if step[:link].present? %>
            <div class="mt-3 pl-10">
              <%= link_to step[:link_text], step[:link], class: "btn btn-xs btn-outline btn-primary" %>
            </div>
          <% end %>
        </section>
      <% end %>
    </div>

    <div class="mt-5 flex flex-wrap items-center justify-between gap-3 border-t border-base-200 pt-4">
      <span class="text-xs text-base-content/50" data-guide-wizard-target="progress"></span>
      <div class="flex items-center gap-2">
        <button type="button" class="btn btn-ghost btn-sm" data-action="guide-wizard#skip">跳过</button>
        <button type="button" class="btn btn-ghost btn-sm" data-guide-wizard-target="prev" data-action="guide-wizard#prev">上一步</button>
        <button type="button" class="btn btn-primary btn-sm" data-guide-wizard-target="next" data-action="guide-wizard#next">下一步</button>
        <button type="button" class="hidden btn btn-primary btn-sm" data-guide-wizard-target="finish" data-action="guide-wizard#finish">开始使用</button>
      </div>
    </div>
  </div>
  <form method="dialog" class="modal-backdrop"><button>close</button></form>
</dialog>
