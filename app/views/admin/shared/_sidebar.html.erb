<%
  current = request.path
  under = ->(prefix) { current.start_with?(prefix) }
%>
<div class="drawer-side z-40">
  <label for="wt-drawer" aria-label="关闭菜单" class="drawer-overlay"></label>
  <aside class="flex min-h-full w-64 flex-col border-r border-base-300/70 bg-base-100">
    <div class="flex items-center gap-3 px-5 py-5">
      <div class="wt-brand-gradient flex h-10 w-10 items-center justify-center rounded-xl text-lg font-bold text-white shadow-sm">维</div>
      <div class="flex-1 leading-tight">
        <p class="text-sm font-semibold">维拓校务</p>
        <p class="text-xs text-base-content/50">教学管理平台</p>
      </div>
      <button type="button" data-action="click->sidebar#toggle" data-sidebar-toggle
              class="btn btn-ghost btn-xs btn-square hidden lg:inline-flex"
              aria-label="隐藏侧边栏" aria-expanded="true">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M15 18l-6-6 6-6" /></svg>
      </button>
    </div>

    <nav class="wt-scroll flex-1 overflow-y-auto px-3 pb-4">
      <p class="px-3 pb-1 pt-2 text-xs font-semibold uppercase tracking-wider text-base-content/40">工作台</p>
      <%= link_to root_path, class: "wt-side-link", aria: { current: ("page" if current == root_path) } do %>
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" /></svg>
        首页概览
      <% end %>

      <p class="px-3 pb-1 pt-4 text-xs font-semibold uppercase tracking-wider text-base-content/40">教务管理</p>
      <% klass_active = under.call("/admin/semester_klasses") && !current.include?("statement") && !current.include?("copy") %>
      <%= link_to admin_semester_klasses_path, class: "wt-side-link", aria: { current: ("page" if klass_active) } do %>
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zm10 0a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zm10 0a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z" /></svg>
        班级管理
      <% end %>
      <%= link_to statement_admin_semester_klasses_path, class: "wt-side-link", aria: { current: ("page" if current.include?("statement")) } do %>
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M3 3v18h18M7 15l4-4 3 3 5-6" /></svg>
        班级报表
      <% end %>
      <%= link_to copy_admin_semester_klasses_path, class: "wt-side-link", aria: { current: ("page" if current.include?("copy")) } do %>
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" /></svg>
        复制历史班级
      <% end %>

      <p class="px-3 pb-1 pt-4 text-xs font-semibold uppercase tracking-wider text-base-content/40">学员与教师</p>
      <%= link_to admin_students_path, class: "wt-side-link", aria: { current: ("page" if under.call("/admin/students")) } do %>
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a4 4 0 00-3-3.87M9 20H4v-2a4 4 0 013-3.87m6-1.13a4 4 0 10-4-4 4 4 0 004 4zm6-4a4 4 0 01-4 4" /></svg>
        学员管理
      <% end %>
      <%= link_to admin_teachers_path, class: "wt-side-link", aria: { current: ("page" if under.call("/admin/teachers")) } do %>
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M12 14l9-5-9-5-9 5 9 5zm0 0v6m-7-8.5v5.5a2 2 0 002 2h10a2 2 0 002-2v-5.5" /></svg>
        教师管理
      <% end %>

      <% if Current.user.has_role_by_campuse_id(Thread.current[:campuse]&.id, "admin") %>
        <p class="px-3 pb-1 pt-4 text-xs font-semibold uppercase tracking-wider text-base-content/40">系统设置</p>
        <%= link_to admin_schools_path, class: "wt-side-link", aria: { current: ("page" if under.call("/admin/schools")) } do %>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M3 21h18M5 21V7l7-4 7 4v14M9 21v-5h6v5M9 10h.01M15 10h.01M9 14h.01M15 14h.01" /></svg>
          学校管理
        <% end %>
        <%= link_to admin_users_path, class: "wt-side-link", aria: { current: ("page" if under.call("/admin/users")) } do %>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" /><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
          用户管理
        <% end %>
      <% end %>
    </nav>

    <div class="border-t border-base-300/70 p-3">
      <div class="rounded-box bg-base-200/70 p-3 text-xs">
        <p class="font-medium text-base-content/70">当前学期</p>
        <p class="mt-1 font-semibold"><%= Thread.current[:semester]&.name || "未设置" %></p>
      </div>
    </div>
  </aside>
</div>
