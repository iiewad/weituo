<div class="space-y-4">
  <div class="wt-surface p-4">
    <div class="flex items-start justify-between gap-2">
      <div>
        <h3 class="text-sm font-semibold">年级报表详情 · <%= row.grade.name %></h3>
        <p class="mt-1 text-xs text-base-content/50"><%= row.semester.name %> · <%= Current.campuse.name %></p>
      </div>
      <span class="badge badge-outline badge-primary badge-sm shrink-0"><%= row.semester.name %></span>
    </div>

    <div class="mt-3 grid grid-cols-2 gap-2 text-xs sm:grid-cols-4">
      <div class="rounded-box bg-base-200/60 p-2.5">
        <p class="text-base-content/50">在班</p>
        <p class="mt-0.5 text-lg font-semibold"><%= row.active_count %><span class="ml-0.5 text-[11px] font-normal text-base-content/40">人</span></p>
      </div>
      <% [
        [ "新增", row.new_count, row.new_rate ],
        [ "拓科", row.expand_count, row.expand_rate ],
        [ "回流", row.return_count, row.return_rate ]
      ].each do |label, count, rate| %>
        <div class="rounded-box bg-base-200/60 p-2.5">
          <p class="text-base-content/50"><%= label %></p>
          <p class="mt-0.5 text-lg font-semibold"><%= count %><span class="ml-0.5 text-[11px] font-normal text-base-content/40">人</span></p>
          <p class="text-[10px] text-base-content/40"><%= (rate * 100).round(1) %>%</p>
        </div>
      <% end %>
    </div>
  </div>

  <div class="wt-surface p-4">
    <h3 class="text-sm font-semibold">学员构成</h3>
    <div class="mt-3 space-y-3.5">
      <% [
        [ "新增", row.new_count, row.new_rate, row.new_students, "bg-secondary" ],
        [ "拓科", row.expand_count, row.expand_rate, row.expand_students, "bg-accent" ],
        [ "回流", row.return_count, row.return_rate, row.return_students, "bg-info" ]
      ].each do |label, count, rate, students, color| %>
        <% pct = (rate * 100).round(1) %>
        <div>
          <div class="flex items-center justify-between text-xs">
            <span class="font-medium"><%= label %> <span class="font-normal text-base-content/50"><%= count %> / <%= row.active_count %></span></span>
            <span class="font-semibold"><%= pct %>%</span>
          </div>
          <div class="mt-1 h-1 w-full rounded-full bg-base-200">
            <span class="block h-1 rounded-full <%= color %>" style="width: <%= pct.clamp(0, 100) %>%"></span>
          </div>
          <% if students.any? %>
            <div class="mt-1.5 max-h-44 space-y-1 overflow-y-auto pr-1">
              <% students.each do |entry| %>
                <div class="rounded-box bg-base-200/60 px-2.5 py-1.5">
                  <p class="text-xs font-medium"><%= entry.name %></p>
                  <p class="mt-0.5 text-[11px] leading-snug text-base-content/50"><%= entry.detail %></p>
                </div>
              <% end %>
            </div>
          <% else %>
            <p class="mt-1 text-[11px] text-base-content/40">无</p>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>

  <div class="wt-surface p-4">
    <div class="flex items-center justify-between gap-2">
      <h3 class="text-sm font-semibold">在班名单</h3>
      <span class="text-xs text-base-content/50">共 <%= row.active_count %> 人</span>
    </div>
    <% if row.active_students.any? %>
      <%
        tag_styles = {
          "新增" => "badge-soft badge-secondary",
          "拓科" => "badge-soft badge-accent",
          "回流" => "badge-soft badge-info",
          "延续" => "badge-ghost"
        }
      %>
      <div class="mt-2 flex max-h-56 flex-wrap gap-1 overflow-y-auto">
        <% row.active_students.each do |entry| %>
          <span class="roster-chip inline-flex items-center gap-1 rounded-full border border-base-300 px-2 py-0.5 text-xs">
            <span><%= entry.name %></span>
            <% entry.tags.each do |tag| %>
              <span class="badge <%= tag_styles.fetch(tag, "badge-ghost") %> badge-xs"><%= tag %></span>
            <% end %>
          </span>
        <% end %>
      </div>
    <% else %>
      <p class="mt-2 text-xs text-base-content/40">该年级本学期暂无在班学员</p>
    <% end %>
  </div>
</div>
