<%= form_with(
  model: item,
  url: item.new_record? ? admin_teachers_path : admin_teacher_path(id: item.id),
  local: true) do |f| %>
  <div class="wt-surface space-y-3 p-4">
    <h3 class="text-sm font-semibold"><%= item.new_record? ? "创建教师" : "更新教师 · #{item.name}" %></h3>

    <div>
      <%= f.label :name, "教师名", class: "mb-1 block text-xs font-medium text-base-content/60" %>
      <%= f.text_field :name, class: "input input-sm w-full", placeholder: "请输入教师姓名", required: true, autocomplete: "off" %>
    </div>

    <div>
      <%= f.label :phone, "电话", class: "mb-1 block text-xs font-medium text-base-content/60" %>
      <%= f.text_field :phone, class: "input input-sm w-full", placeholder: "选填", autocomplete: "off" %>
    </div>

    <div>
      <%= f.label :subject_id, "科目", class: "mb-1 block text-xs font-medium text-base-content/60" %>
      <%= f.select :subject_id, Subject.order(:id).map { |subject| [subject.name, subject.id] }, { prompt: "请选择科目" }, class: "select select-sm w-full", required: true %>
    </div>

    <div class="pt-1">
      <%= f.submit "保存", class: "btn btn-sm btn-primary" %>
    </div>
  </div>
<% end %>
