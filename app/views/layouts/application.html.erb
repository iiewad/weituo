<!DOCTYPE html>
<html lang="zh-CN" data-theme="weituo">
  <head>
    <script>
      if (localStorage.getItem("wt-sidebar-collapsed") === "true") {
        document.documentElement.classList.add("wt-sidebar-collapsed")
      }
    </script>
    <title><%= content_for(:title) || "维拓校务管理平台" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Weituo">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-dvh bg-base-200 text-base-content antialiased">
    <% if authenticated? %>
      <div class="drawer wt-drawer lg:drawer-open" data-controller="sidebar">
        <input id="wt-drawer" type="checkbox" class="drawer-toggle" data-sidebar-target="drawerToggle" />
        <div class="drawer-content flex min-h-dvh flex-col">
          <%= render "admin/shared/navbar" %>
          <main class="flex-1 px-4 py-5 lg:px-8 lg:py-6">
            <div class="mx-auto w-full max-w-[1600px]">
              <%= render "admin/shared/alert" %>
              <%= render "admin/shared/page_header" %>
              <%= yield %>
            </div>
          </main>
          <%= render "admin/shared/footer" %>
        </div>
        <%= render "admin/shared/sidebar" %>
      </div>
    <% else %>
      <%= render "admin/shared/navbar" %>
      <main>
        <%= render "admin/shared/alert" %>
        <%= yield %>
      </main>
    <% end %>
  </body>
</html>
